# Fichiers envoyés : jamais exécutés comme du code.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
