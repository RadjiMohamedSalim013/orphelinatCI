{% extends 'base.html.twig' %}

{% block title %}Administration — OrphaMap CI{% endblock %}
{% block meta_robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block page %}
    {% set admin_route = app.request.attributes.get('_route') %}
    {% set admin_nav_compteurs = admin_compteurs() %}
    {% set admin_sections = [
        {titre: 'Pilotage', liens: [
            {route: 'admin_dashboard', prefix: 'admin_dashboard', label: 'Tableau de bord', icon: 'fa-chart-simple'},
        ]},
        {titre: 'À traiter', liens: [
            {route: 'admin_propositions_index', prefix: 'admin_propositions', label: 'Propositions', icon: 'fa-inbox', compteur: admin_nav_compteurs.propositions},
            {route: 'admin_signalements_index', prefix: 'admin_signalements', label: 'Signalements', icon: 'fa-flag', compteur: admin_nav_compteurs.signalements},
        ]},
        {titre: 'Annuaire', liens: [
            {route: 'admin_orphelinat_list', prefix: 'admin_orphelinat', label: 'Établissements', icon: 'fa-house-chimney-window'},
            {route: 'admin_localisations_index', prefix: 'admin_localisations', label: 'Localisations', icon: 'fa-map-location-dot'},
        ]},
        {titre: 'Système', liens: [
            {route: 'admin_backups_index', prefix: 'admin_backups', label: 'Sauvegardes', icon: 'fa-database'},
            {route: 'admin_security_index', prefix: 'admin_security', label: 'Audit sécurité', icon: 'fa-shield-halved'},
        ]},
    ] %}

    <div class="min-h-screen bg-page lg:pl-64" data-controller="menu">
        {# Barre supérieure mobile #}
        <div class="sticky top-0 z-30 flex h-14 items-center justify-between border-b border-ink-200 bg-white px-4 lg:hidden">
            <a href="{{ path('admin_dashboard') }}" class="rounded-md">{% include 'partials/_logo.html.twig' with {suffixe: 'Admin'} %}</a>
            <button type="button" class="om-btn-icon om-btn-ghost" data-menu-target="button" data-action="menu#toggle" aria-expanded="false" aria-controls="admin-menu">
                <i class="fa-solid fa-bars text-lg" aria-hidden="true"></i><span class="sr-only">Menu d’administration</span>
            </button>
        </div>

        <div class="fixed inset-0 z-40 bg-ink-950/40 lg:hidden" data-menu-target="overlay" data-action="click->menu#close" hidden></div>

        <aside id="admin-menu" data-menu-target="panel"
               class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col border-r border-ink-200 bg-white transition-transform duration-200 data-[open=true]:translate-x-0 lg:w-64 lg:translate-x-0">
            <div class="flex h-16 shrink-0 items-center justify-between px-5">
                <a href="{{ path('admin_dashboard') }}" class="rounded-md">{% include 'partials/_logo.html.twig' with {suffixe: 'Admin'} %}</a>
                <button type="button" class="om-btn-icon om-btn-ghost lg:hidden" data-action="menu#close">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i><span class="sr-only">Fermer le menu</span>
                </button>
            </div>

            <nav class="flex-1 overflow-y-auto px-3 py-2" aria-label="Administration">
                {% for section in admin_sections %}
                    <p class="mb-1 mt-4 px-3 text-[11px] font-semibold uppercase tracking-[.12em] text-ink-400 first:mt-0">{{ section.titre }}</p>
                    <ul class="space-y-0.5">
                        {% for lien in section.liens %}
                            {% set admin_actif = admin_route starts with lien.prefix %}
                            <li>
                                <a href="{{ path(lien.route) }}"
                                   class="group flex min-h-[40px] items-center gap-3 rounded-md px-3 text-sm font-medium transition {{ admin_actif ? 'bg-brand-50 text-brand-800' : 'text-ink-600 hover:bg-ink-50 hover:text-ink-900' }}"
                                   {% if admin_actif %}aria-current="page"{% endif %}>
                                    <i class="fa-solid {{ lien.icon }} w-4 text-center {{ admin_actif ? 'text-brand-600' : 'text-ink-400 group-hover:text-ink-600' }}" aria-hidden="true"></i>
                                    <span class="flex-1">{{ lien.label }}</span>
                                    {% if lien.compteur|default(0) > 0 %}<span class="om-count">{{ lien.compteur }}<span class="sr-only"> à traiter</span></span>{% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endfor %}
            </nav>

            <div class="shrink-0 border-t border-ink-200 p-3">
                <div class="flex items-center gap-3 px-3 py-2">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink-900 text-xs font-bold uppercase text-white" aria-hidden="true">{{ app.user.userIdentifier|first }}</span>
                    <p class="min-w-0 truncate text-sm text-ink-700" title="{{ app.user.userIdentifier }}">{{ app.user.userIdentifier }}</p>
                </div>
                <div class="mt-1 grid grid-cols-2 gap-1">
                    <a href="{{ path('home') }}" class="om-btn-ghost om-btn-sm !justify-start" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i> Site</a>
                    <a href="{{ path('app_logout') }}" class="om-btn-ghost om-btn-sm !justify-start"><i class="fa-solid fa-right-from-bracket text-xs" aria-hidden="true"></i> Quitter</a>
                </div>
            </div>
        </aside>

        <main id="contenu" class="mx-auto w-full max-w-[90rem] px-4 py-6 sm:px-6 lg:px-10 lg:py-8">
            {% block content %}{% endblock %}
        </main>
    </div>
{% endblock %}
