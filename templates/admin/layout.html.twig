<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Admin Panel{% endblock %}</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <!-- FontAwesome (icônes propres) -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        /* smooth UI */
        body {
            font-family: ui-sans-serif, system-ui, -apple-system;
        }

        .sidebar-link {
            transition: all .2s ease;
        }

        .sidebar-link:hover {
            transform: translateX(3px);
        }

        .sidebar-link.active {
            background: #fff7ed;
            color: #f97316;
            font-weight: 600;
        }
    </style>
</head>

<body class="bg-gray-50">

<!-- ================= OVERLAY MOBILE ================= -->
<div id="overlay"
     class="fixed inset-0 bg-black/40 hidden lg:hidden z-40"
     onclick="toggleSidebar()"></div>

<!-- ================= SIDEBAR ================= -->
<aside id="sidebar"
    class="fixed top-0 left-0 h-full w-72 bg-white border-r shadow-xl z-50
           transform -translate-x-full lg:translate-x-0 transition-all duration-300">

    <!-- HEADER SIDEBAR -->
    <div class="p-6 border-b">
        <h1 class="text-xl font-bold tracking-tight">
            <i class="fa-solid fa-shield-halved text-orange-500 mr-2"></i>
            OrphaMap <span class="text-orange-500">Admin</span>
        </h1>
        <p class="text-xs text-gray-400 mt-1">Administration panel</p>
    </div>

    <!-- NAV -->
    <nav class="p-4 space-y-2">

        <a href="{{ path('admin_dashboard') }}"
           class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500">
            <i class="fa-solid fa-chart-line w-5"></i>
            Dashboard
        </a>

        <a href="{{ path('admin_propositions_index') }}"
           class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500">
            <i class="fa-solid fa-inbox w-5"></i>
            Propositions
        </a>

        <a href="{{ path('admin_orphelinat_list') }}"
           class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500">
            <i class="fa-solid fa-house-user w-5"></i>
            Orphelinats
        </a>

    </nav>

    <!-- FOOTER SIDEBAR -->
    <div class="absolute bottom-0 w-full p-4 border-t text-xs text-gray-400">
        © OrphaMap Admin
    </div>

</aside>

<!-- ================= MAIN ================= -->
<div class="lg:ml-72 min-h-screen flex flex-col">

    <!-- HEADER -->
    <header class="h-16 bg-white border-b flex items-center justify-between px-6 sticky top-0 z-30">

        <!-- MOBILE BUTTON -->
        <button class="lg:hidden text-gray-600"
                onclick="toggleSidebar()">
            <i class="fa-solid fa-bars text-xl"></i>
        </button>

        <h2 class="font-semibold text-gray-700">
            {% block page_title %}Admin{% endblock %}
        </h2>

        <!-- USER -->
        <div class="flex items-center gap-3 text-sm text-gray-600">

            <div class="h-9 w-9 rounded-full bg-orange-100 flex items-center justify-center">
                <i class="fa-solid fa-user text-orange-500"></i>
            </div>

            <span class="hidden sm:block">
                {{ app.user.email ?? '' }}
            </span>

        </div>

    </header>

    <!-- CONTENT -->
    <main class="p-6">

        {% include 'partials/_flashes.html.twig' %}

        {% block content %}{% endblock %}

    </main>

</div>

<!-- ================= JS ================= -->
<script>
function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');

    sidebar.classList.toggle('-translate-x-full');
    overlay.classList.toggle('hidden');
}
</script>

</body>
</html>