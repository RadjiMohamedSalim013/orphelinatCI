{% extends 'admin/layout.html.twig' %}

{% block title %}Audit de sécurité — Administration OrphaMap CI{% endblock %}

{% set severites = {
    critical: {label: 'Critique', badge: 'om-badge-danger', icone: 'circle-alert', ton: 'bg-red-50 text-red-700'},
    high: {label: 'Élevée', badge: 'om-badge-brand', icone: 'triangle-alert', ton: 'bg-brand-50 text-brand-700'},
    medium: {label: 'Moyenne', badge: 'om-badge-warning', icone: 'info', ton: 'bg-amber-50 text-amber-700'},
    low: {label: 'Faible', badge: 'om-badge-neutral', icone: 'info', ton: 'bg-ink-100 text-ink-700'},
} %}

{% block content %}
    {% embed 'admin/_page_header.html.twig' with {titre: 'Audit de sécurité', sous_titre: 'Contrôle des permissions, des fichiers déposés, des sauvegardes et de la configuration.'} %}
        {% block actions %}
            <form method="post" action="{{ path('admin_security_audit_run') }}" data-controller="ui" data-action="submit->ui#loading">
                <input type="hidden" name="_token" value="{{ csrf_token('audit_run') }}">
                <button type="submit" class="om-btn-primary" data-ui-target="submit" data-loading-label="Audit en cours…">{{ ux_icon('lucide:shield-check') }}Lancer un audit</button>
            </form>
        {% endblock %}
    {% endembed %}

    <section class="grid grid-cols-2 gap-3 sm:gap-4 xl:grid-cols-4" aria-label="Constats des 30 derniers jours">
        {% for cle in ['critical', 'high', 'medium'] %}
            {% set s = severites[cle] %}
            <div class="om-card p-4 sm:p-5" data-reveal style="--i: {{ loop.index0 }}">
                <div class="flex items-start justify-between gap-3">
                    <p class="text-sm font-medium text-ink-600">Gravité {{ s.label|lower }}</p>
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg {{ s.ton }}" aria-hidden="true">{{ ux_icon('lucide:' ~ (s.icone), {class: 'text-sm'}) }}</span>
                </div>
                <p class="mt-2 font-display text-2xl font-extrabold tabular-nums text-ink-900 sm:text-3xl">{{ attribute(statistics, cle)|default(0) }}</p>
                <p class="mt-1 text-xs text-ink-500">Sur 30 jours</p>
            </div>
        {% endfor %}
        <div class="om-card p-4 sm:p-5" data-reveal style="--i: 3">
            <div class="flex items-start justify-between gap-3">
                <p class="text-sm font-medium text-ink-600">Total des constats</p>
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-ink-100 text-ink-700" aria-hidden="true">{{ ux_icon('lucide:list-checks', {class: 'text-sm'}) }}</span>
            </div>
            <p class="mt-2 font-display text-2xl font-extrabold tabular-nums text-ink-900 sm:text-3xl">{{ statistics.total|default(0) }}</p>
            <p class="mt-1 text-xs text-ink-500">Sur 30 jours</p>
        </div>
    </section>

    <section class="mt-6" aria-labelledby="titre-a-traiter">
        <h2 id="titre-a-traiter" class="mb-3 flex items-center gap-2 font-display text-lg font-bold text-ink-900">
            Points à traiter
            {% if unresolved_issues is not empty %}<span class="om-badge-brand">{{ unresolved_issues|length }}</span>{% endif %}
        </h2>

        {% if unresolved_issues is empty %}
            {% embed 'partials/_empty.html.twig' with {icone: 'shield-check', titre: 'Aucun point en attente', texte: 'Le dernier audit n’a rien relevé qui demande votre attention. Relancez-en un après chaque mise à jour.'} %}{% endembed %}
        {% else %}
            <ul class="om-card divide-y divide-ink-100" role="list">
                {% for issue in unresolved_issues %}
                    {% set s = severites[issue.severity] ?? severites.low %}
                    <li class="flex flex-col gap-3 p-4 sm:flex-row sm:items-start sm:justify-between sm:p-5">
                        <div class="flex min-w-0 gap-3">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg {{ s.ton }}" aria-hidden="true">{{ ux_icon('lucide:' ~ (s.icone), {class: 'text-sm'}) }}</span>
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="{{ s.badge }}">{{ s.label }}</span>
                                    <span class="font-mono text-xs text-ink-500">{{ issue.type }}</span>
                                </div>
                                <p class="mt-1 break-words text-sm text-ink-800">{{ issue.message }}</p>
                                <p class="mt-1 inline-flex items-center gap-1 text-xs text-ink-500">{{ ux_icon('lucide:clock') }}Relevé le {{ issue.createdAt|date('d/m/Y à H\\hi') }}</p>
                            </div>
                        </div>
                        <form method="post" action="{{ path('admin_security_issue_resolve', {id: issue.id}) }}" class="shrink-0"
                              data-confirm="Ce point disparaîtra de la liste. Il réapparaîtra au prochain audit si le problème persiste."
                              data-confirm-title="Marquer comme résolu ?" data-confirm-label="Marquer résolu">
                            <input type="hidden" name="_token" value="{{ csrf_token('issue_resolve_' ~ issue.id) }}">
                            <button type="submit" class="om-btn-secondary !min-h-[36px] text-sm">{{ ux_icon('lucide:check') }}Résolu</button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="mt-6" aria-labelledby="titre-historique">
        <h2 id="titre-historique" class="mb-3 font-display text-lg font-bold text-ink-900">Historique des 7 derniers jours</h2>
        {% if recent_audits is empty %}
            {% embed 'partials/_empty.html.twig' with {icone: 'history', titre: 'Aucun audit récent', texte: 'Lancez un audit pour obtenir un premier état des lieux.'} %}{% endembed %}
        {% else %}
            <div class="om-card overflow-hidden">
                <table class="om-table">
                    <caption class="sr-only">Constats des 7 derniers jours</caption>
                    <thead>
                        <tr>
                            <th scope="col">Constat</th>
                            <th scope="col">Gravité</th>
                            <th scope="col">Date</th>
                            <th scope="col">Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for audit in recent_audits %}
                            {% set s = severites[audit.severity] ?? severites.low %}
                            <tr>
                                <td>
                                    <span class="block font-mono text-xs text-ink-500">{{ audit.type }}</span>
                                    <span class="block max-w-md truncate text-ink-800 max-md:max-w-[14rem]" title="{{ audit.message }}">{{ audit.message }}</span>
                                </td>
                                <td data-label="Gravité"><span class="{{ s.badge }}">{{ s.label }}</span></td>
                                <td data-label="Date" class="whitespace-nowrap tabular-nums text-ink-600">{{ audit.createdAt|date('d/m/Y H:i') }}</td>
                                <td data-label="Statut">
                                    {% if audit.resolved %}
                                        <span class="om-badge-trust">{{ ux_icon('lucide:check') }}Résolu</span>
                                    {% else %}
                                        <span class="om-badge-warning">{{ ux_icon('lucide:hourglass') }}À traiter</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
