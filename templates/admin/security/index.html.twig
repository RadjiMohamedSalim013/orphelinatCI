{% extends 'admin/layout.html.twig' %}

{% block title %}Audit de Sécurité - OrphaMap Admin{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto space-y-6">
    
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-ink-900">
                <i class="fa-solid fa-shield-halved text-brand-500 mr-2"></i>
                Audit de Sécurité
            </h1>
            <p class="text-ink-500 mt-1">Surveillance et analyse des problèmes de sécurité</p>
        </div>
        
        <button onclick="runAudit()" 
                class="bg-brand-500 hover:bg-brand-600 text-white font-semibold py-2 px-4 rounded-lg transition">
            <i class="fa-solid fa-magnifying-glass mr-2"></i>
            Lancer un Audit
        </button>
    </div>

    <!-- Messages flash -->
    <div id="audit-messages"></div>

    <!-- Statistiques -->
    <div class="grid md:grid-cols-4 gap-4">
        <div class="bg-white border rounded-lg p-6">
            <div class="flex items-center gap-3">
                <div class="bg-red-100 p-3 rounded-lg">
                    <i class="fa-solid fa-circle-exclamation text-red-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-sm text-ink-500">Critiques</p>
                    <p class="text-2xl font-bold text-red-600">{{ statistics.critical }}</p>
                </div>
            </div>
        </div>
        
        <div class="bg-white border rounded-lg p-6">
            <div class="flex items-center gap-3">
                <div class="bg-brand-100 p-3 rounded-lg">
                    <i class="fa-solid fa-triangle-exclamation text-brand-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-sm text-ink-500">Élevés</p>
                    <p class="text-2xl font-bold text-brand-600">{{ statistics.high }}</p>
                </div>
            </div>
        </div>
        
        <div class="bg-white border rounded-lg p-6">
            <div class="flex items-center gap-3">
                <div class="bg-yellow-100 p-3 rounded-lg">
                    <i class="fa-solid fa-exclamation text-yellow-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-sm text-ink-500">Moyens</p>
                    <p class="text-2xl font-bold text-yellow-600">{{ statistics.medium }}</p>
                </div>
            </div>
        </div>
        
        <div class="bg-white border rounded-lg p-6">
            <div class="flex items-center gap-3">
                <div class="bg-ink-100 p-3 rounded-lg">
                    <i class="fa-solid fa-list text-ink-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-sm text-ink-500">Total</p>
                    <p class="text-2xl font-bold text-ink-900">{{ statistics.total }}</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Problèmes non résolus -->
    <div class="bg-white border rounded-lg overflow-hidden">
        <div class="p-4 border-b bg-ink-50 flex items-center justify-between">
            <h2 class="font-semibold text-ink-800">
                <i class="fa-solid fa-triangle-exclamation mr-2 text-brand-500"></i>
                Problèmes Non Résolus ({{ unresolved_issues|length }})
            </h2>
        </div>

        {% if unresolved_issues|length > 0 %}
            <div class="divide-y divide-ink-200">
                {% for issue in unresolved_issues %}
                    <div class="p-4 hover:bg-ink-50">
                        <div class="flex items-start justify-between">
                            <div class="flex items-start gap-3 flex-1">
                                {% set severityIcon = issue.severity == 'critical' ? 'fa-circle-exclamation text-red-600' : 
                                                       issue.severity == 'high' ? 'fa-triangle-exclamation text-brand-600' : 
                                                       'fa-exclamation text-yellow-600' %}
                                <i class="fa-solid {{ severityIcon }} mt-1"></i>
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="px-2 py-1 text-xs rounded-full font-semibold
                                            {% if issue.severity == 'critical' %}bg-red-100 text-red-700
                                            {% elseif issue.severity == 'high' %}bg-brand-100 text-brand-700
                                            {% else %}bg-yellow-100 text-yellow-700{% endif %}">
                                            {{ issue.severity|upper }}
                                        </span>
                                        <span class="text-xs text-ink-500">{{ issue.type }}</span>
                                    </div>
                                    <p class="text-sm text-ink-800">{{ issue.message }}</p>
                                    <p class="text-xs text-ink-500 mt-1">
                                        <i class="fa-regular fa-clock mr-1"></i>
                                        {{ issue.createdAt|date('d/m/Y H:i') }}
                                    </p>
                                </div>
                            </div>
                            <button onclick="resolveIssue({{ issue.id }})" 
                                    class="ml-4 text-green-600 hover:text-green-700 text-sm font-semibold whitespace-nowrap">
                                <i class="fa-solid fa-check mr-1"></i>
                                Résoudre
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="p-12 text-center">
                <i class="fa-solid fa-shield-check text-green-500 text-6xl mb-4"></i>
                <p class="text-ink-500 text-lg">Aucun problème de sécurité détecté</p>
                <p class="text-ink-400 text-sm mt-2">Votre système est sécurisé</p>
            </div>
        {% endif %}
    </div>

    <!-- Derniers audits -->
    <div class="bg-white border rounded-lg overflow-hidden">
        <div class="p-4 border-b bg-ink-50">
            <h2 class="font-semibold text-ink-800">
                <i class="fa-solid fa-clock-rotate-left mr-2"></i>
                Derniers Audits (7 derniers jours)
            </h2>
        </div>

        {% if recent_audits|length > 0 %}
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-ink-50 border-b">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-ink-500 uppercase">Type</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-ink-500 uppercase">Sévérité</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-ink-500 uppercase">Message</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-ink-500 uppercase">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-ink-500 uppercase">Statut</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink-200">
                        {% for audit in recent_audits %}
                            <tr class="hover:bg-ink-50">
                                <td class="px-6 py-4 text-sm text-ink-600">{{ audit.type }}</td>
                                <td class="px-6 py-4">
                                    <span class="px-2 py-1 text-xs rounded-full font-semibold
                                        {% if audit.severity == 'critical' %}bg-red-100 text-red-700
                                        {% elseif audit.severity == 'high' %}bg-brand-100 text-brand-700
                                        {% elseif audit.severity == 'medium' %}bg-yellow-100 text-yellow-700
                                        {% else %}bg-ink-100 text-ink-700{% endif %}">
                                        {{ audit.severity }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-sm text-ink-800">{{ audit.message|slice(0, 80) }}{% if audit.message|length > 80 %}...{% endif %}</td>
                                <td class="px-6 py-4 text-sm text-ink-600">{{ audit.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="px-6 py-4">
                                    {% if audit.resolved %}
                                        <span class="px-2 py-1 bg-green-100 text-green-700 text-xs rounded-full">
                                            <i class="fa-solid fa-check mr-1"></i>Résolu
                                        </span>
                                    {% else %}
                                        <span class="px-2 py-1 bg-red-100 text-red-700 text-xs rounded-full">
                                            <i class="fa-solid fa-circle-xmark mr-1"></i>Non résolu
                                        </span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="p-8 text-center text-ink-500">
                <i class="fa-solid fa-inbox text-4xl mb-2"></i>
                <p>Aucun audit récent</p>
            </div>
        {% endif %}
    </div>


</div>

<script>
function runAudit() {
    const btn = event.target.closest('button');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Audit en cours...';

    fetch('{{ path('admin_security_audit_run') }}', {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            '{{ csrf_token('audit_run') }}': '{{ csrf_token('audit_run') }}'
        }
    })
    .then(response => response.json())
    .then(data => {
        const messagesDiv = document.getElementById('audit-messages');
        if (data.success) {
            messagesDiv.innerHTML = `
                <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg p-4 mb-4">
                    <i class="fa-solid fa-check-circle mr-2"></i>
                    ${data.message}
                </div>
            `;
            setTimeout(() => location.reload(), 2000);
        } else {
            messagesDiv.innerHTML = `
                <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg p-4 mb-4">
                    <i class="fa-solid fa-exclamation-circle mr-2"></i>
                    ${data.message}
                </div>
            `;
        }
        btn.disabled = false;
        btn.innerHTML = originalText;
    })
    .catch(error => {
        console.error('Error:', error);
        btn.disabled = false;
        btn.innerHTML = originalText;
    });
}

function resolveIssue(id) {
    if (!confirm('Marquer ce problème comme résolu ?')) {
        return;
    }

    fetch(`{{ path('admin_security_issue_resolve', {'id': 'PLACEHOLDER'}) }}`.replace('PLACEHOLDER', id), {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            '{{ csrf_token('issue_resolve') }}': '{{ csrf_token('issue_resolve') }}'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert(data.message);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Erreur lors de la résolution du problème');
    });
}
</script>

{% endblock %}