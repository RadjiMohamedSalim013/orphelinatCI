{% extends 'admin/layout.html.twig' %}

{% block title %}Orphelinats - OrphaMap Admin{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto py-8 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-3">
            <div class="h-12 w-12 bg-orange-100 rounded-xl flex items-center justify-center">
                <svg class="h-6 w-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-3xl font-bold tracking-tight text-gray-800 mb-1">Orphelinats</h1>
                <p class="text-md text-gray-500">{{ totalCount }} enregistre{{ totalCount > 1 ? 's' : '' }}</p>
            </div>
        <a href="{{ path('admin_orphelinat_create') }}" class="inline-flex items-center gap-2 rounded-xl bg-orange-500 px-5 py-3 text-sm font-bold text-white shadow-lg hover:bg-orange-600 transition">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Nouvel orphelinat
        </a>
    </div>

    <!-- Search -->
    <div class="mb-6">
        <form method="GET" class="flex gap-3">
            <input type="text" name="search" value="{{ search }}" placeholder="Rechercher par nom, description, adresse..." 
                   class="flex-1 px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 shadow-sm">
            <button type="submit" class="px-6 py-3 bg-blue-600 text-white rounded-xl font-medium hover:bg-blue-700 transition shadow-sm">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </button>
            {% if search %}
                <a href="{{ path('admin_orphelinat_list') }}" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-xl font-medium hover:bg-gray-300 transition">
                    Effacer
                </a>
            {% endif %}
        </form>
    </div>

    {% if orphelinats|length > 0 %}
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Image</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Nom</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider hidden md:table-cell">Adresse</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Contact</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider hidden lg:table-cell">Localisation</th>
                            <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for orphelinat in orphelinats %}
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4">
                                {% if orphelinat.image %}
                                    <img src="/uploads/images/{{ orphelinat.image }}" alt="{{ orphelinat.nom }}" class="h-12 w-12 rounded-lg object-cover">
                                {% else %}
                                    <div class="h-12 w-12 rounded-lg bg-orange-100 flex items-center justify-center">
                                        <svg class="h-6 w-6 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                    </div>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 font-semibold text-gray-800">{{ orphelinat.nom }}</td>
                            <td class="px-6 py-4 hidden md:table-cell text-sm text-gray-500">{{ orphelinat.adresse }}</td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col gap-1">
                                    <span class="text-sm text-gray-600">{{ orphelinat.telephone }}</span>
                                    <span class="text-sm text-gray-500">{{ orphelinat.email }}</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 hidden lg:table-cell">
                                {% if orphelinat.quartier %}
                                    <span class="text-sm text-gray-600">{{ orphelinat.quartier.nom }}, {{ orphelinat.quartier.commune.nom }}, {{ orphelinat.quartier.commune.ville.nom }}</span>
                                {% else %}
                                    <span class="text-sm text-gray-400">-</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="{{ path('orphelinat_show', {'id': orphelinat.id}) }}" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-blue-600 hover:text-blue-800 hover:bg-blue-50 rounded-lg transition">
                                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                        Voir
                                    </a>
                                    <a href="{{ path('admin_orphelinat_edit', {'id': orphelinat.id}) }}" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-orange-600 hover:text-orange-800 hover:bg-orange-50 rounded-lg transition">
                                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                        Modifier
                                    </a>
                                    <form method="post" action="{{ path('admin_orphelinat_delete', {'id': orphelinat.id}) }}" class="inline" onsubmit="return confirm('Supprimer cet orphelinat ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_orphelinat_' ~ orphelinat.id) }}">
                                        <button class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-red-600 hover:text-red-800 hover:bg-red-50 rounded-lg transition" type="submit">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                            Supprimer
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        <!-- Pagination -->
        {% if totalPages > 1 %}
        <div class="mt-8 flex items-center justify-center space-x-2">
            {% if currentPage > 1 %}
                <a href="{{ path('admin_orphelinat_list', {page: currentPage - 1, search: search}) }}" class="px-4 py-2 bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition">Precedent</a>
            {% endif %}
            {% for p in 1..totalPages %}
                <a href="{{ path('admin_orphelinat_list', {page: p, search: search}) }}" class="px-3 py-2 {{ p == currentPage ? 'bg-orange-500 text-white' : 'bg-white text-gray-700 border border-gray-300' }} rounded-lg hover:bg-orange-50 transition font-medium">
                    {{ p }}
                </a>
            {% endfor %}
            {% if currentPage < totalPages %}
                <a href="{{ path('admin_orphelinat_list', {page: currentPage + 1, search: search}) }}" class="px-4 py-2 bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition">Suivant</a>
            {% endif %}
        </div>
        {% endif %}
    {% else %}
        <div class="bg-white rounded-2xl shadow-xl p-12 text-center border border-gray-100">
            <div class="w-20 h-20 mx-auto mb-4 bg-orange-100 rounded-full flex items-center justify-center">
                <svg class="h-10 w-10 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                </svg>
            </div>
            <h4 class="text-xl font-bold text-gray-700 mb-2">Aucun orphelinat trouve</h4>
            <p class="text-gray-500">Ajoutez un nouvel orphelinat pour commencer.</p>
        </div>
    {% endif %}
</div>
{% endblock %}
