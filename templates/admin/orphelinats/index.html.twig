{% extends 'admin/layout.html.twig' %}

{% block title %}Établissements — Administration OrphaMap CI{% endblock %}

{% block content %}
    {% set actifs = filtres.q or filtres.commune or filtres.statut or filtres.verification %}

    {% embed 'admin/_page_header.html.twig' with {titre: 'Établissements', sous_titre: resultats.total ~ ' fiche' ~ (resultats.total > 1 ? 's') ~ (actifs ? ' correspondant aux filtres' : ' au total')} %}
        {% block actions %}
            <a href="{{ path('admin_orphelinat_create') }}" class="om-btn-primary">{{ ux_icon('lucide:plus') }} Ajouter</a>
        {% endblock %}
    {% endembed %}

    <form method="get" class="om-card mb-5 grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.6fr)_repeat(4,minmax(0,1fr))_auto] lg:items-end" role="search" aria-label="Filtrer les établissements"
          data-controller="ui" data-action="submit->ui#loading" data-ui-busy-selector-value="#table-orphelinats">
        <div class="sm:col-span-2 lg:col-span-1">
            <label for="a-q" class="om-label">Recherche</label>
            <input id="a-q" type="search" name="q" value="{{ filtres.q }}" class="om-input" placeholder="Nom, adresse, téléphone…">
        </div>
        <div>
            <label for="a-commune" class="om-label">Commune</label>
            <select id="a-commune" name="commune" class="om-input">
                <option value="">Toutes</option>
                {% for c in communes %}<option value="{{ c.id }}" {{ filtres.commune == c.id ? 'selected' }}>{{ c.nom }} ({{ c.ville.nom }})</option>{% endfor %}
            </select>
        </div>
        <div>
            <label for="a-statut" class="om-label">Situation</label>
            <select id="a-statut" name="statut" class="om-input">
                <option value="">Toutes</option>
                {% for s in enum_cases('App\\Enum\\OrphelinatStatut') %}<option value="{{ s.value }}" {{ filtres.statut == s ? 'selected' }}>{{ s.label }}</option>{% endfor %}
            </select>
        </div>
        <div>
            <label for="a-verif" class="om-label">Vérification</label>
            <select id="a-verif" name="verification" class="om-input">
                <option value="">Toutes</option>
                {% for v in enum_cases('App\\Enum\\VerificationStatut') %}<option value="{{ v.value }}" {{ filtres.verification == v ? 'selected' }}>{{ v.label }}</option>{% endfor %}
            </select>
        </div>
        <div>
            <label for="a-tri" class="om-label">Trier par</label>
            <select id="a-tri" name="tri" class="om-input">
                {% for valeur, libelle in {nom: 'Nom', commune: 'Commune', recent: 'Plus récents', maj: 'Dernière mise à jour'} %}
                    <option value="{{ valeur }}" {{ filtres.tri == valeur ? 'selected' }}>{{ libelle }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="flex gap-2 sm:col-span-2 lg:col-span-1">
            <button class="om-btn-primary flex-1" type="submit" data-ui-target="submit" data-loading-label="Filtrage…">Filtrer</button>
            {% if actifs %}<a class="om-btn-secondary" href="{{ path('admin_orphelinat_list') }}">Effacer</a>{% endif %}
        </div>
    </form>

    <div id="table-orphelinats" class="om-card overflow-hidden transition aria-[busy=true]:opacity-50">
        {% if resultats.items is empty %}
            <div class="px-6 py-14 text-center">
                <p class="font-semibold text-ink-900">Aucun établissement ne correspond à ces filtres.</p>
                {% if actifs %}<a href="{{ path('admin_orphelinat_list') }}" class="om-link mt-2 inline-block text-sm">Effacer les filtres</a>{% endif %}
            </div>
        {% else %}
            <table class="om-table">
                <caption class="sr-only">Liste des établissements</caption>
                <thead>
                    <tr>
                        <th scope="col">Établissement</th>
                        <th scope="col">Localisation</th>
                        <th scope="col">Téléphone</th>
                        <th scope="col">Statut</th>
                        <th scope="col"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for o in resultats.items %}
                        <tr>
                            <td>
                                <a href="{{ path('admin_orphelinat_show', {id: o.id}) }}" class="font-semibold text-ink-900 hover:text-brand-700">{{ o.nom }}</a>
                                <p class="mt-0.5 text-xs text-ink-500">
                                    Ajouté le {{ o.createdAt|date('d/m/Y') }}
                                    {% if not o.hasCoordinates %}<span class="ml-1 text-amber-700">{{ ux_icon('lucide:locate-fixed') }} sans position</span>{% endif %}
                                </p>
                            </td>
                            <td data-label="Localisation">{{ o.commune.nom }}<span class="block text-xs text-ink-500">{{ o.ville.nom }}</span></td>
                            <td data-label="Téléphone" class="whitespace-nowrap tabular-nums">{{ o.telephone ?: '—' }}</td>
                            <td data-label="Statut">
                                <div class="flex flex-wrap justify-end gap-1 md:justify-start">
                                    {% include 'admin/_statut_badge.html.twig' with {statut: o.statut} %}
                                    {% include 'partials/_verification_badge.html.twig' with {orphelinat: o} %}
                                </div>
                            </td>
                            <td data-label="" class="md:text-right">
                                <a href="{{ path('admin_orphelinat_edit', {id: o.id}) }}" class="om-btn-secondary om-btn-sm w-full md:w-auto">{{ ux_icon('lucide:pencil', {class: 'text-xs'}) }} Modifier<span class="sr-only"> {{ o.nom }}</span></a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {% include 'partials/_pagination.html.twig' with {
        page: resultats.page, pages: resultats.pages, route: 'admin_orphelinat_list',
        params: {q: filtres.q, commune: filtres.commune, statut: filtres.statut ? filtres.statut.value, verification: filtres.verification ? filtres.verification.value, tri: filtres.tri}|filter(v => v)
    } %}
{% endblock %}
