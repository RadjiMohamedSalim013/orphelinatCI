
{% extends 'admin/layout.html.twig' %}

{% form_theme form 'form/tailwind_layout.html.twig' %}

{% block title %}Modifier {{ orphelinat.nom }} - OrphaMap Admin{% endblock %}

{% block content %}
<div class="max-w-4xl">
    <div class="mb-8">
        <div class="flex items-center gap-4">
            <a href="{{ path('admin_orphelinat_list') }}" class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-gray-900 shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all border border-gray-200">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                Retour a la liste
            </a>
        </div>
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 mt-4">
            Modifier l'orphelinat
        </h1>
        <p class="text-xl text-gray-600 mt-2">{{ orphelinat.nom }}</p>
    </div>

    {{ include('partials/_flashes.html.twig') }}

    {% if orphelinat.image %}
    <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">Image actuelle</label>
        <img src="/uploads/images/{{ orphelinat.image }}" alt="{{ orphelinat.nom }}" class="h-32 w-32 rounded-xl object-cover border border-gray-200">
    </div>
    {% endif %}

    {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

        <!-- Informations générales -->
        <div class="space-y-6">
            <div class="flex items-center gap-3 pb-3 border-b border-gray-200">
                <div class="h-10 w-10 bg-blue-100 rounded-lg flex items-center justify-center">
                    <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-gray-900">Informations générales</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_row(form.nom, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition'}}) }}
                </div>
                <div>
                    {{ form_row(form.adresse, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition'}}) }}
                </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_row(form.telephone, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition'}}) }}
                </div>
                <div>
                    {{ form_row(form.email, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition'}}) }}
                </div>

            <div>
                {{ form_row(form.description, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition', 'rows': 6}}) }}
            </div>

        <!-- Localisation -->
        <div class="space-y-6">
            <div class="flex items-center gap-3 pb-3 border-b border-gray-200">
                <div class="h-10 w-10 bg-orange-100 rounded-lg flex items-center justify-center">
                    <svg class="h-5 w-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-gray-900">Localisation</h2>
            </div>

            <div class="bg-blue-50 rounded-xl p-6 border border-blue-100">
                <div class="flex items-center gap-2 mb-4">
                    <div class="h-6 w-6 bg-blue-500 rounded-full flex items-center justify-center text-white text-xs font-bold">1</div>
                    <h3 class="font-semibold text-gray-900">Choisir un quartier existant</h3>
                </div>
                {{ form_row(form.quartier, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition'}}) }}
            </div>

            <div class="flex items-center gap-4">
                <div class="flex-1 h-px bg-gray-200"></div>
                <span class="text-sm text-gray-500 font-medium uppercase">ou créer nouveau</span>
                <div class="flex-1 h-px bg-gray-200"></div>

            <div class="bg-orange-50 rounded-xl p-6 border border-orange-100">
                <div class="flex items-center gap-2 mb-4">
                    <div class="h-6 w-6 bg-orange-500 rounded-full flex items-center justify-center text-white text-xs font-bold">2</div>
                    <h3 class="font-semibold text-gray-900">Créer une nouvelle localisation</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        {{ form_row(form.nouveau_pays, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition'}}) }}
                    </div>
                    <div>
                        {{ form_row(form.nouvelle_ville, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition'}}) }}
                    </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
                    <div>
                        {{ form_row(form.nouvelle_commune, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition'}}) }}
                    </div>
                    <div>
                        {{ form_row(form.nouveau_quartier, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition'}}) }}
                    </div>

                <p class="text-sm text-orange-600 mt-3">
                    <svg class="h-4 w-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Si vous remplissez ces champs, le quartier existant sera ignoré.
                </p>
            </div>

        <!-- Fichiers -->
        <div class="space-y-6">
            <div class="flex items-center gap-3 pb-3 border-b border-gray-200">
                <div class="h-10 w-10 bg-green-100 rounded-lg flex items-center justify-center">
                    <svg class="h-5 w-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-gray-900">Fichiers</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_row(form.image, {'label': 'Nouvelle photo (JPG, PNG max 5Mo)', 'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition'}}) }}
                </div>
                <div>
                    {{ form_row(form.document, {'label': 'Nouveau document (PDF max 10Mo)', 'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition'}}) }}
                </div>
        </div>

        <div class="flex gap-4 pt-8 border-t border-gray-200">
            <a href="{{ path('admin_orphelinat_list') }}" class="flex-1 inline-flex justify-center rounded-xl bg-gray-100 px-8 py-4 text-lg font-semibold text-gray-900 hover:bg-gray-200 transition">
                Annuler
            </a>
            <button type="submit" class="flex-1 inline-flex items-center justify-center gap-3 rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-8 py-4 text-lg font-bold text-white shadow-lg hover:shadow-xl hover:-translate-y-1 transition">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Sauvegarder
            </button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
