{% extends 'admin/layout.html.twig' %}

{% form_theme form 'form/tailwind_layout.html.twig' %}

{% block title %}Modifier {{ orphelinat.nom }} - OrphaMap Admin{% endblock %}

{% block content %}

<style>
/* ================= FORM UX CUSTOM ================= */
.form-input input,
.form-input textarea,
.form-input select {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fff;
    transition: all .2s ease;
    font-size: 14px;
}

.form-input input:focus,
.form-input textarea:focus,
.form-input select:focus {
    border-color: #f97316;
    box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.15);
    outline: none;
}

/* file input */
input[type="file"] {
    padding: 10px;
    border: 1px dashed #d1d5db;
    border-radius: 12px;
    background: #fafafa;
}

/* card hover soft */
.card {
    transition: all .2s ease;
}

.card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
}
</style>

<div class="max-w-4xl mx-auto space-y-10">

    <!-- ================= HEADER ================= -->
    <div class="space-y-3">

        <a href="{{ path('admin_orphelinat_list') }}"
           class="inline-flex items-center gap-2 px-4 py-2 bg-white border rounded-xl shadow-sm hover:shadow transition w-fit">

            <i class="fa-solid fa-arrow-left text-gray-600"></i>
            Retour
        </a>

        <h1 class="text-4xl font-bold text-gray-900">
            Modifier l’orphelinat
        </h1>

        <p class="text-gray-500 flex items-center gap-2">
            <i class="fa-solid fa-building text-orange-500"></i>
            {{ orphelinat.nom }}
        </p>

    </div>

    {{ include('partials/_flashes.html.twig') }}

    <!-- ================= IMAGE ================= -->
    <div class="card bg-white border rounded-2xl overflow-hidden">

        <div class="p-4 border-b flex items-center gap-2 font-semibold text-gray-700">
            <i class="fa-solid fa-image text-orange-500"></i>
            Image actuelle
        </div>

        {% if orphelinat.image %}
            <img src="/uploads/images/{{ orphelinat.image }}"
                 class="w-full h-64 object-cover">
        {% else %}
            <div class="h-64 flex items-center justify-center bg-gray-100 text-gray-400">
                <div class="text-center">
                    <i class="fa-regular fa-image text-4xl"></i>
                    <p class="mt-2">Aucune image</p>
                </div>
            </div>
        {% endif %}

    </div>

    {{ form_start(form, {'attr': {'class': 'space-y-10'}}) }}

    <!-- ================= INFO ================= -->
    <div class="card bg-white border rounded-2xl p-6 space-y-6 form-input">

        <div class="flex items-center gap-2 font-semibold text-gray-800">
            <i class="fa-solid fa-circle-info text-orange-500"></i>
            Informations générales
        </div>

        <!-- ROW GROUP -->
        <div class="grid md:grid-cols-2 gap-5">
            {{ form_row(form.nom) }}
            {{ form_row(form.email) }}
        </div>

        <div class="grid md:grid-cols-2 gap-5">
            {{ form_row(form.telephone) }}
            {{ form_row(form.adresse) }}
        </div>

        {{ form_row(form.description) }}

    </div>

    <!-- ================= LOCALISATION ================= -->
    <div class="card bg-white border rounded-2xl p-6 space-y-6 form-input">

        <div class="flex items-center gap-2 font-semibold text-gray-800">
            <i class="fa-solid fa-location-dot text-blue-500"></i>
            Localisation
        </div>

        <!-- EXISTANT -->
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-5 space-y-3">

            <div class="flex items-center gap-2 text-blue-700 font-semibold">
                <i class="fa-solid fa-map-pin"></i>
                Quartier existant
            </div>

            {{ form_row(form.quartier) }}

        </div>

        <!-- SEPARATOR -->
        <div class="flex items-center gap-4">
            <div class="h-px bg-gray-200 flex-1"></div>
            <span class="text-xs text-gray-400 uppercase">ou</span>
            <div class="h-px bg-gray-200 flex-1"></div>
        </div>

        <!-- NEW -->
        <div class="bg-orange-50 border border-orange-100 rounded-xl p-5 space-y-5">

            <div class="flex items-center gap-2 text-orange-600 font-semibold">
                <i class="fa-solid fa-plus-circle"></i>
                Nouvelle localisation
            </div>

            <div class="grid md:grid-cols-2 gap-5">
                {{ form_row(form.nouveau_pays) }}
                {{ form_row(form.nouvelle_ville) }}
            </div>

            <div class="grid md:grid-cols-2 gap-5">
                {{ form_row(form.nouvelle_commune) }}
                {{ form_row(form.nouveau_quartier) }}
            </div>

        </div>

    </div>

    <!-- ================= FILES ================= -->
    <div class="card bg-white border rounded-2xl p-6 space-y-6 form-input">

        <div class="flex items-center gap-2 font-semibold text-gray-800">
            <i class="fa-solid fa-file text-green-500"></i>
            Fichiers
        </div>

        <div class="grid md:grid-cols-2 gap-5">
            {{ form_row(form.image, {'label': 'Image (JPG/PNG)'}) }}
            {{ form_row(form.document, {'label': 'Document PDF'}) }}
        </div>

    </div>

    <!-- ================= ACTIONS ================= -->
    <div class="flex flex-col sm:flex-row gap-4">

        <a href="{{ path('admin_orphelinat_list') }}"
           class="flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-3 rounded-xl flex items-center justify-center gap-2">

            <i class="fa-solid fa-xmark"></i>
            Annuler
        </a>

        <button type="submit"
                class="flex-1 bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-xl flex items-center justify-center gap-2">

            <i class="fa-solid fa-floppy-disk"></i>
            Sauvegarder
        </button>

    </div>

    {{ form_end(form) }}

</div>

{% endblock %}