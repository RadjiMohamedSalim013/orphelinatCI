{% extends 'admin/layout.html.twig' %}

{% form_theme form 'form/tailwind_layout.html.twig' %}

{% block title %}Créer Orphelinat - OrphaMap Admin{% endblock %}

{% block content %}

<style>
/* ================= MODERN ADMIN UI ================= */

.page-wrapper {
    max-width: 1100px;
    margin: auto;
}

/* card moderne */
.card {
    background: #fff;
    border: 1px solid #eef2f7;
    border-radius: 18px;
    padding: 22px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    transition: 0.2s ease;
}

.card:hover {
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    transform: translateY(-2px);
}

/* section title */
.section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 15px;
    color: #111827;
    margin-bottom: 18px;
}

/* inputs modern UX */
input, select, textarea {
    width: 100%;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    background: #fff;
    transition: 0.2s;
    font-size: 14px;
}

input:focus, select:focus, textarea:focus {
    border-color: #f97316;
    box-shadow: 0 0 0 4px rgba(249,115,22,0.12);
    outline: none;
}

/* label */
label {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 6px;
    display: block;
}

/* file input */
input[type="file"] {
    border: 1px dashed #d1d5db;
    background: #fafafa;
}

/* button primary */
.btn-primary {
    background: #f97316;
    color: white;
    font-weight: 700;
    padding: 14px 18px;
    border-radius: 14px;
    transition: 0.2s;
}

.btn-primary:hover {
    background: #ea580c;
    transform: translateY(-1px);
}

/* button secondary */
.btn-secondary {
    background: #f3f4f6;
    color: #111827;
    font-weight: 600;
    padding: 14px 18px;
    border-radius: 14px;
}

.btn-secondary:hover {
    background: #e5e7eb;
}

</style>

<div class="page-wrapper space-y-10">

    <!-- ================= HEADER ================= -->
    <div class="space-y-4">

        <a href="{{ path('admin_dashboard') }}"
           class="inline-flex items-center gap-2 px-4 py-2 bg-white border rounded-xl shadow-sm hover:shadow-md transition w-fit">

            <i class="fa-solid fa-arrow-left text-gray-600"></i>
            Retour dashboard
        </a>

        <div class="flex items-center gap-4">

            <div class="h-12 w-12 bg-orange-100 rounded-xl flex items-center justify-center">
                <i class="fa-solid fa-building text-orange-600"></i>
            </div>

            <div>
                <h1 class="text-3xl font-bold text-gray-900">
                    Créer un orphelinat
                </h1>
                <p class="text-gray-500 text-sm">
                    Ajouter une structure dans la plateforme OrphaMap
                </p>
            </div>

        </div>

    </div>

    {{ include('partials/_flashes.html.twig') }}

    {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

    <!-- ================= INFOS ================= -->
    <section class="card">

        <div class="section-title">
            <i class="fa-solid fa-circle-info text-orange-500"></i>
            Informations générales
        </div>

        <div class="grid md:grid-cols-2 gap-6">

            <div>{{ form_row(form.nom) }}</div>
            <div>{{ form_row(form.adresse) }}</div>
            <div>{{ form_row(form.telephone) }}</div>
            <div>{{ form_row(form.email) }}</div>

        </div>

        <div class="mt-6">
            {{ form_row(form.description) }}
        </div>

    </section>

    <!-- ================= LOCALISATION ================= -->
    <section class="card">

        <div class="section-title">
            <i class="fa-solid fa-location-dot text-orange-500"></i>
            Localisation
        </div>

        <div class="bg-blue-50 p-4 rounded-xl mb-6">

            <div class="flex items-center gap-2 font-semibold mb-2">
                <i class="fa-solid fa-map"></i>
                Quartier existant
            </div>

            {{ form_row(form.quartier) }}

        </div>

        <div class="flex items-center gap-4 my-4">
            <div class="flex-1 h-px bg-gray-200"></div>
            <span class="text-xs text-gray-500">OU</span>
            <div class="flex-1 h-px bg-gray-200"></div>
        </div>

        <div class="bg-orange-50 p-4 rounded-xl">

            <div class="flex items-center gap-2 font-semibold mb-4">
                <i class="fa-solid fa-plus text-orange-500"></i>
                Nouvelle localisation
            </div>

            <div class="grid md:grid-cols-2 gap-6">

                {{ form_row(form.nouveau_pays) }}
                {{ form_row(form.nouvelle_ville) }}
                {{ form_row(form.nouvelle_commune) }}
                {{ form_row(form.nouveau_quartier) }}

            </div>

        </div>

    </section>

    <!-- ================= FILES ================= -->
    <section class="card">

        <div class="section-title">
            <i class="fa-solid fa-file text-orange-500"></i>
            Fichiers
        </div>

        <div class="grid md:grid-cols-2 gap-6">
            {{ form_row(form.image) }}
            {{ form_row(form.document) }}
        </div>

    </section>

    <!-- ================= ACTIONS ================= -->
    <div class="flex flex-col md:flex-row gap-4">

        <a href="{{ path('admin_dashboard') }}"
           class="btn-secondary flex-1 text-center">

            Annuler
        </a>

        <button type="submit"
                class="btn-primary flex-1">

            <i class="fa-solid fa-check mr-2"></i>
            Créer l’orphelinat
        </button>

    </div>

    {{ form_end(form) }}

</div>

{% endblock %}