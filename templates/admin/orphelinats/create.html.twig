{% extends 'admin/layout.html.twig' %}

{% form_theme form 'form/tailwind_layout.html.twig' %}

{% block title %}Créer Orphelinat - OrphaMap Admin{% endblock %}

{% block content %}
<div class="max-w-4xl">
    <div class="mb-12">
        <div class="flex items-center gap-4">
            <a href="{{ path('admin_dashboard') }}" class="inline-flex items-center gap-2 rounded-2xl bg-white dark:bg-gray-800 px-5 py-3 text-sm font-semibold text-gray-900 dark:text-white shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all border border-gray-200 dark:border-gray-700">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                Retour Dashboard
            </a>
        </div>
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white mt-4">
            Créer un nouvel orphelinat
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mt-2">Ajoutez directement un orphelinat à la base de données.</p>
    </div>

    {{ include('partials/_flashes.html.twig') }}

    {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

        <!-- Informations générales -->
        <div class="space-y-6">
            <div class="flex items-center gap-3 pb-3 border-b border-gray-200 dark:border-gray-700">
                <div class="h-10 w-10 bg-blue-100 dark:bg-blue-900/40 rounded-lg flex items-center justify-center">
                    <svg class="h-5 w-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-gray-900 dark:text-white">Informations générales</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_row(form.nom, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white transition'}}) }}
                </div>
                <div>
                    {{ form_row(form.adresse, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white transition'}}) }}
                </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_row(form.telephone, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white transition'}}) }}
                </div>
                <div>
                    {{ form_row(form.email, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white transition'}}) }}
                </div>

            <div>
                {{ form_row(form.description, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white transition', 'rows': 6}}) }}
            </div>

        <!-- Localisation -->
        <div class="space-y-6">
            <div class="flex items-center gap-3 pb-3 border-b border-gray-200 dark:border-gray-700">
                <div class="h-10 w-10 bg-orange-100 dark:bg-orange-900/40 rounded-lg flex items-center justify-center">
                    <svg class="h-5 w-5 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-gray-900 dark:text-white">Localisation</h2>
            </div>

            <!-- Option 1: Choisir existant -->
            <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-6 border border-blue-100 dark:border-blue-800">
                <div class="flex items-center gap-2 mb-4">
                    <div class="h-6 w-6 bg-blue-500 rounded-full flex items-center justify-center text-white text-xs font-bold">1</div>
                    <h3 class="font-semibold text-gray-900 dark:text-white">Choisir un quartier existant</h3>
                </div>
                {{ form_row(form.quartier, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white transition'}}) }}
            </div>

            <div class="flex items-center gap-4">
                <div class="flex-1 h-px bg-gray-200 dark:bg-gray-700"></div>
                <span class="text-sm text-gray-500 dark:text-gray-400 font-medium uppercase">ou créer nouveau</span>
                <div class="flex-1 h-px bg-gray-200 dark:bg-gray-700"></div>

            <!-- Option 2: Créer nouveau -->
            <div class="bg-orange-50 dark:bg-orange-900/20 rounded-xl p-6 border border-orange-100 dark:border-orange-800">
                <div class="flex items-center gap-2 mb-4">
                    <div class="h-6 w-6 bg-orange-500 rounded-full flex items-center justify-center text-white text-xs font-bold">2</div>
                    <h3 class="font-semibold text-gray-900 dark:text-white">Créer une nouvelle localisation</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        {{ form_row(form.nouveau_pays, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white transition'}}) }}
                    </div>
                    <div>
                        {{ form_row(form.nouvelle_ville, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white transition'}}) }}
                    </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
                    <div>
                        {{ form_row(form.nouvelle_commune, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white transition'}}) }}
                    </div>
                    <div>
                        {{ form_row(form.nouveau_quartier, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white transition'}}) }}
                    </div>

                <p class="text-sm text-orange-600 dark:text-orange-400 mt-3">
                    <svg class="h-4 w-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Si vous remplissez ces champs, le quartier existant sera ignoré.
                </p>
            </div>

        <!-- Fichiers -->
        <div class="space-y-6">
            <div class="flex items-center gap-3 pb-3 border-b border-gray-200 dark:border-gray-700">
                <div class="h-10 w-10 bg-green-100 dark:bg-green-900/40 rounded-lg flex items-center justify-center">
                    <svg class="h-5 w-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-gray-900 dark:text-white">Fichiers</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div>
                    {{ form_row(form.image, {'label': 'Photo (JPG, PNG max 5Mo)', 'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white transition'}}) }}
                </div>
                <div>
                    {{ form_row(form.document, {'label': 'Document (PDF max 10Mo)', 'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 dark:bg-gray-700 dark:text-white transition'}}) }}
                </div>
        </div>

        <div class="flex gap-4 pt-8 border-t border-gray-200 dark:border-gray-700">
            <a href="{{ path('admin_dashboard') }}" class="flex-1 inline-flex justify-center rounded-2xl bg-gray-100 px-8 py-4 text-lg font-semibold text-gray-900 hover:bg-gray-200 dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600 transition-all">
                <svg class="h-6 w-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Annuler
            </a>
            <button type="submit" class="flex-1 group flex items-center justify-center gap-3 rounded-2xl bg-gradient-to-r from-orange-500 to-orange-600 px-8 py-4 text-lg font-bold text-white shadow-2xl hover:shadow-3xl hover:-translate-y-1 transition-all">
                <svg class="h-6 w-6 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Créer l'orphelinat
            </button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
