{% extends 'admin/layout.html.twig' %}

{% block title %}Sauvegardes — Administration OrphaMap CI{% endblock %}

{% block content %}
    {% embed 'admin/_page_header.html.twig' with {titre: 'Sauvegardes', sous_titre: 'Copies de la base de données et des fichiers déposés, conservées 30 jours sur le serveur.', backups: backups} %}
        {% block actions %}
            {% if backups is not empty %}
                <form method="post" action="{{ path('admin_backups_clean') }}"
                      data-confirm="Les sauvegardes de plus de 30 jours seront supprimées du serveur. Les plus récentes sont conservées."
                      data-confirm-title="Supprimer les anciennes sauvegardes ?" data-confirm-label="Supprimer" data-confirm-variant="danger">
                    <input type="hidden" name="_token" value="{{ csrf_token('backup_clean') }}">
                    <button type="submit" class="om-btn-secondary">{{ ux_icon('lucide:trash-2') }}Nettoyer</button>
                </form>
            {% endif %}
            <form method="post" action="{{ path('admin_backups_create') }}" data-controller="ui" data-action="submit->ui#loading"
                  data-confirm="La base de données et les fichiers déposés seront copiés. L’opération peut prendre quelques minutes."
                  data-confirm-title="Créer une sauvegarde ?" data-confirm-label="Lancer la sauvegarde">
                <input type="hidden" name="_token" value="{{ csrf_token('backup_create') }}">
                <button type="submit" class="om-btn-primary" data-ui-target="submit" data-loading-label="Sauvegarde en cours…">{{ ux_icon('lucide:plus') }}Nouvelle sauvegarde</button>
            </form>
        {% endblock %}
    {% endembed %}

    {% set derniere = backups|first %}
    <section class="grid gap-4 sm:grid-cols-3" aria-label="Résumé">
        {% for kpi in [
            {libelle: 'Fichiers de sauvegarde', valeur: backups|length, icone: 'archive', ton: 'bg-ink-100 text-ink-700'},
            {libelle: 'Dernière sauvegarde', valeur: derniere ? derniere.date|date('d/m/Y') : '—', detail: derniere ? 'à ' ~ derniere.date|date('H\\hi') : 'Aucune pour le moment', icone: 'clock', ton: 'bg-brand-50 text-brand-700'},
            {libelle: 'Durée de conservation', valeur: '30 jours', detail: 'Au-delà, « Nettoyer » les supprime', icone: 'history', ton: 'bg-trust-50 text-trust-700'},
        ] %}
            <div class="om-card p-5" data-reveal style="--i: {{ loop.index0 }}">
                <div class="flex items-start justify-between gap-3">
                    <p class="text-sm font-medium text-ink-600">{{ kpi.libelle }}</p>
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg {{ kpi.ton }}" aria-hidden="true">{{ ux_icon('lucide:' ~ (kpi.icone), {class: 'text-sm'}) }}</span>
                </div>
                <p class="mt-2 font-display text-3xl font-extrabold tabular-nums text-ink-900">{{ kpi.valeur }}</p>
                {% if kpi.detail is defined %}<p class="mt-1 text-xs text-ink-500">{{ kpi.detail }}</p>{% endif %}
            </div>
        {% endfor %}
    </section>

    <section class="mt-6" aria-labelledby="titre-historique">
        <h2 id="titre-historique" class="mb-3 font-display text-lg font-bold text-ink-900">Historique</h2>
        {% if backups is empty %}
            {% embed 'partials/_empty.html.twig' with {icone: 'package-open', titre: 'Aucune sauvegarde disponible', texte: 'Créez une première sauvegarde avant toute mise à jour importante du site.'} %}{% endembed %}
        {% else %}
            <div class="om-card overflow-hidden">
                <table class="om-table">
                    <caption class="sr-only">Fichiers de sauvegarde, du plus récent au plus ancien</caption>
                    <thead>
                        <tr>
                            <th scope="col">Fichier</th>
                            <th scope="col">Contenu</th>
                            <th scope="col">Taille</th>
                            <th scope="col">Créé le</th>
                            <th scope="col"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for backup in backups %}
                            <tr>
                                <td>
                                    <span class="flex min-w-0 items-center gap-2">
                                        {{ ux_icon('lucide:file-archive', {class: 'text-ink-400'}) }}
                                        <span class="truncate font-mono text-xs text-ink-800 max-md:max-w-[14rem]">{{ backup.name }}</span>
                                    </span>
                                </td>
                                <td data-label="Contenu">
                                    {% if '.sql' in backup.name %}
                                        <span class="om-badge-info">{{ ux_icon('lucide:database') }}Base de données</span>
                                    {% else %}
                                        <span class="om-badge-trust">{{ ux_icon('lucide:hard-drive') }}Fichiers</span>
                                    {% endif %}
                                </td>
                                <td data-label="Taille" class="whitespace-nowrap tabular-nums text-ink-600">{{ backup.size }}</td>
                                <td data-label="Créé le" class="whitespace-nowrap tabular-nums text-ink-600">{{ backup.date|date('d/m/Y H:i') }}</td>
                                <td data-label="" class="text-right">
                                    <a href="{{ path('admin_backups_download', {filename: backup.name}) }}" class="om-btn-ghost !min-h-[36px] !px-3 text-sm">
                                        {{ ux_icon('lucide:download') }}Télécharger<span class="sr-only"> {{ backup.name }}</span>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    <div class="om-alert-info mt-6">
        {{ ux_icon('lucide:info', {class: 'mt-0.5'}) }}
        <div>
            <p class="font-semibold">Bon à savoir</p>
            <ul class="mt-1 list-disc space-y-0.5 pl-5">
                <li>Chaque sauvegarde comprend la base de données (SQL compressé) et les fichiers déposés.</li>
                <li>Faites une sauvegarde avant chaque mise à jour importante, puis téléchargez-la : sur un hébergement gratuit, le disque du serveur peut être effacé lors d’un redéploiement.</li>
            </ul>
        </div>
    </div>
{% endblock %}
