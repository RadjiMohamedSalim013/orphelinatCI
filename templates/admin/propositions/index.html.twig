{% extends 'admin/layout.html.twig' %}

{% block title %}Propositions — Administration OrphaMap CI{% endblock %}

{% block content %}
    {% embed 'admin/_page_header.html.twig' with {titre: 'Propositions du public', sous_titre: 'Aucune proposition n’est publiée sans validation.'} %}{% endembed %}

    {% set onglets = [
        {cle: 'ouvertes', label: 'À traiter', n: compteurs.en_attente + compteurs.en_verification},
        {cle: 'en_attente', label: 'En attente', n: compteurs.en_attente},
        {cle: 'en_verification', label: 'En vérification', n: compteurs.en_verification},
        {cle: 'acceptee', label: 'Acceptées', n: compteurs.acceptee},
        {cle: 'refusee', label: 'Refusées', n: compteurs.refusee},
        {cle: 'toutes', label: 'Toutes', n: null},
    ] %}
    <nav class="om-tabs" aria-label="Filtrer par statut">
        {% for o in onglets %}
            <a href="{{ path('admin_propositions_index', {statut: o.cle}) }}" class="om-tab" {% if filtre == o.cle %}aria-current="page"{% endif %}>
                {{ o.label }}{% if o.n is not null %}<span class="rounded-full bg-ink-100 px-1.5 text-xs font-semibold text-ink-600">{{ o.n }}</span>{% endif %}
            </a>
        {% endfor %}
    </nav>

    <div class="om-card mt-5 overflow-hidden">
        {% if propositions is empty %}
            <div class="flex flex-col items-center px-6 py-14 text-center">
                <span class="om-empty-icon" aria-hidden="true"><i class="fa-solid fa-inbox"></i></span>
                <p class="font-semibold text-ink-900">Aucune proposition dans cette catégorie.</p>
                {% if filtre == 'ouvertes' %}<p class="mt-1 text-sm text-ink-500">Tout est traité.</p>{% endif %}
            </div>
        {% else %}
            <table class="om-table">
                <caption class="sr-only">Propositions</caption>
                <thead>
                    <tr>
                        <th scope="col">Établissement proposé</th>
                        <th scope="col">Localisation</th>
                        <th scope="col">Reçue le</th>
                        <th scope="col">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in propositions %}
                        <tr>
                            <td>
                                <a href="{{ path('admin_propositions_show', {id: p.id}) }}" class="font-semibold text-ink-900 hover:text-brand-700">{{ p.nom }}</a>
                                <span class="mt-0.5 block font-mono text-xs text-ink-400">{{ p.reference }}</span>
                            </td>
                            <td data-label="Localisation">
                                {{ p.communeLabel ?: '—' }}
                                {% if not p.commune %}<span class="om-badge-warning ml-1"><i class="fa-solid fa-circle-question text-[10px]" aria-hidden="true"></i> hors référentiel</span>{% endif %}
                                <span class="block text-xs text-ink-500">{{ p.ville }}, {{ p.pays }}</span>
                            </td>
                            <td data-label="Reçue le" class="whitespace-nowrap tabular-nums text-ink-600">{{ p.createdAt|date('d/m/Y H:i') }}</td>
                            <td data-label="Statut">{% include 'admin/_statut_badge.html.twig' with {statut: p.statut} %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
