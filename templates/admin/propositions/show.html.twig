{% extends 'admin/layout.html.twig' %}

{% block title %}Dossier - {{ proposition.nom }}{% endblock %}

{% block content %}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    .sheet {
        background:#fff;
        border:1px solid #eee;
        border-radius:20px;
        box-shadow:0 10px 35px rgba(0,0,0,0.06);
        overflow:hidden;
    }

    .status {
        background: linear-gradient(135deg,#f59e0b,#fbbf24);
        color:white;
        padding:14px 18px;
        display:flex;
        justify-content:space-between;
        align-items:center;
    }

    .badge {
        background:rgba(255,255,255,0.25);
        padding:6px 12px;
        border-radius:999px;
        font-size:12px;
        font-weight:700;
        display:flex;
        align-items:center;
        gap:6px;
    }

    .photo {
        width:100%;
        height:340px;
        object-fit:cover;
        background:#f3f4f6;
    }

    .section {
        padding:18px;
        border-top:1px solid #f3f4f6;
    }

    .grid2 {
        display:grid;
        grid-template-columns:repeat(2,1fr);
        gap:12px;
    }

    .box {
        background:#f9fafb;
        border:1px solid #f3f4f6;
        border-radius:14px;
        padding:12px;
    }

    .label {
        font-size:12px;
        color:#6b7280;
    }

    .value {
        font-weight:600;
        color:#111827;
        margin-top:4px;
    }

    .actions {
        display:flex;
        justify-content:flex-end;
        gap:10px;
        padding:18px;
        border-top:1px solid #f3f4f6;
        background:#fafafa;
    }

    .btn {
        padding:10px 16px;
        border-radius:12px;
        font-weight:600;
        display:flex;
        align-items:center;
        gap:8px;
        cursor:pointer;
        transition:.2s;
        border:none;
    }

    .btn-green {
        background:#16a34a;
        color:white;
    }

    .btn-green:hover {
        background:#15803d;
    }

    .btn-red {
        background:#dc2626;
        color:white;
    }

    .btn-red:hover {
        background:#b91c1c;
    }

    .btn-gray {
        background:#e5e7eb;
        color:#374151;
    }

    .btn-gray:hover {
        background:#d1d5db;
    }
</style>

<div class="max-w-4xl mx-auto px-4 py-10">

    <!-- BACK -->
    <a href="{{ path('admin_propositions_index') }}"
       class="inline-flex items-center gap-2 text-gray-600 hover:text-orange-600 mb-4">
        <i class="fa-solid fa-arrow-left"></i>
        Retour
    </a>

    <!-- CARD -->
    <div class="sheet">

        <!-- STATUS HEADER -->
        <div class="status">

            <div>
                <div class="text-xl font-bold flex items-center gap-2">
                    <i class="fa-solid fa-building"></i>
                    {{ proposition.nom }}
                </div>

                <div class="text-sm opacity-90 mt-1">
                    <i class="fa-regular fa-clock"></i>
                    Soumis le {{ proposition.createdAt|date('d/m/Y H:i') }}
                </div>
            </div>

            <div class="badge">
                <i class="fa-solid fa-hourglass-half"></i>
                EN ATTENTE
            </div>

        </div>

        <!-- PHOTO HERO -->
        {% if proposition.image %}
            <img src="{{ asset('uploads/images/' ~ proposition.image) }}"
                 class="photo">
        {% else %}
            <div class="photo flex items-center justify-center text-gray-400">
                <i class="fa-solid fa-image text-5xl"></i>
            </div>
        {% endif %}

        <!-- DESCRIPTION -->
        <div class="section">
            <div class="label">
                <i class="fa-solid fa-align-left text-orange-500"></i>
                Description
            </div>
            <div class="value">
                {{ proposition.description|nl2br }}
            </div>
        </div>

        <!-- PROPOSANT -->
        <div class="section">
            <div class="label">
                <i class="fa-solid fa-user text-orange-500"></i>
                Proposant
            </div>

            <div class="box">
                <div class="value">{{ proposition.nomProposant }}</div>
                <div class="label">
                    <i class="fa-solid fa-phone text-orange-500"></i>
                    {{ proposition.contactProposant }}
                </div>
            </div>
        </div>

        <!-- CONTACT -->
        <div class="section">

            <div class="grid2">

                <div class="box">
                    <div class="label">Téléphone</div>
                    <div class="value">
                        <i class="fa-solid fa-phone text-blue-500"></i>
                        {{ proposition.telephone }}
                    </div>
                </div>

                <div class="box">
                    <div class="label">Email</div>
                    <div class="value">
                        <i class="fa-solid fa-envelope text-blue-500"></i>
                        {{ proposition.email }}
                    </div>
                </div>

            </div>

        </div>

        <!-- LOCALISATION -->
        <div class="section">

            <div class="grid2">

                <div class="box">
                    <div class="label">Pays</div>
                    <div class="value">{{ proposition.pays }}</div>
                </div>

                <div class="box">
                    <div class="label">Ville</div>
                    <div class="value">{{ proposition.ville }}</div>
                </div>

                <div class="box">
                    <div class="label">Quartier</div>
                    <div class="value">{{ proposition.quartier }}</div>
                </div>

                <div class="box">
                    <div class="label">Adresse</div>
                    <div class="value">{{ proposition.adresse }}</div>
                </div>

            </div>

        </div>

        <!-- ACTIONS -->
        <div class="actions">

            <!-- REFUSER -->
            <form method="post"
                  action="{{ path('admin_propositions_refuser', {'id': proposition.id}) }}">
                <input type="hidden" name="_token"
                       value="{{ csrf_token('refuser_proposition_' ~ proposition.id) }}">

                <button class="btn btn-red">
                    <i class="fa-solid fa-xmark"></i>
                    Refuser
                </button>
            </form>

            <!-- VALIDER -->
            <form method="post"
                  action="{{ path('admin_propositions_valider', {'id': proposition.id}) }}">
                <input type="hidden" name="_token"
                       value="{{ csrf_token('valider_proposition_' ~ proposition.id) }}">

                <button class="btn btn-green">
                    <i class="fa-solid fa-check"></i>
                    Valider
                </button>
            </form>

        </div>

    </div>
</div>

{% endblock %}