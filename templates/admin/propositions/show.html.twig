{% extends 'admin/layout.html.twig' %}

{% block title %}Détails - {{ proposition.nom }} - OrphaMap Admin{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 py-8">
    <!-- En-tête avec navigation -->
    <div class="mb-8">
        <a href="{{ path('admin_propositions_index') }}" class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-medium transition">
            <i class="fas fa-arrow-left"></i>
            Retour aux propositions
        </a>
    </div>

    <!-- Carte principale -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
        <!-- En-tête avec nom et statut -->
        <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-8 py-6">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <h1 class="text-3xl font-bold text-white">{{ proposition.nom }}</h1>
                <span class="inline-flex items-center gap-2 bg-orange-500 text-white px-4 py-2 rounded-full text-sm font-semibold shadow-md">
                    <i class="fas fa-hourglass-half"></i>
                    {{ proposition.statut|title }}
                </span>
            </div>
            <p class="text-blue-100 mt-2">
                <i class="fas fa-calendar-alt mr-2"></i>Proposé le {{ proposition.createdAt|date('d/m/Y à H:i') }}
            </p>
        </div>

        <div class="p-8">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Colonne de gauche : contenu principal -->
                <div class="lg:col-span-2 space-y-8">
                    <!-- Image -->
                    {% if proposition.image %}
                    <div>
                        <div class="rounded-xl overflow-hidden shadow-lg border border-gray-200">
                            <img src="{{ asset('uploads/images/' ~ proposition.image) }}" alt="{{ proposition.nom }}" class="w-full h-80 object-cover">
                        </div>
                    </div>
                    {% endif %}

                    <!-- Description -->
                    <div>
                        <div class="flex items-center gap-3 mb-4 pb-2 border-b border-gray-200">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center">
                                <i class="fas fa-align-left text-blue-600 text-lg"></i>
                            </div>
                            <h2 class="text-xl font-bold text-gray-800">Description</h2>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-6 text-gray-700 leading-relaxed">
                            {{ proposition.description|nl2br }}
                        </div>
                    </div>
                </div>

                <!-- Colonne de droite : informations -->
                <div class="space-y-6">
                    <!-- Carte Proposant -->
                    <div>
                        <div class="flex items-center gap-3 mb-4 pb-2 border-b border-gray-200">
                            <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center">
                                <i class="fas fa-user text-orange-600 text-lg"></i>
                            </div>
                            <h2 class="text-xl font-bold text-gray-800">Proposant</h2>
                        </div>
                        <div class="bg-gradient-to-r from-orange-50 to-white rounded-xl p-5 border border-orange-100">
                            <div class="flex items-center gap-4">
                                <div class="w-14 h-14 rounded-xl bg-orange-500 flex items-center justify-center text-white font-bold text-xl shadow-md">
                                    {{ proposition.nomProposant|slice(0,2)|upper }}
                                </div>
                                <div>
                                    <p class="font-bold text-gray-800 text-lg">{{ proposition.nomProposant }}</p>
                                    <p class="text-gray-500">
                                        <i class="fas fa-phone-alt mr-2 text-orange-500"></i>{{ proposition.contactProposant }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Carte Contact -->
                    <div>
                        <div class="flex items-center gap-3 mb-4 pb-2 border-b border-gray-200">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center">
                                <i class="fas fa-address-book text-blue-600 text-lg"></i>
                            </div>
                            <h2 class="text-xl font-bold text-gray-800">Contact</h2>
                        </div>
                        <div class="space-y-3">
                            <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                                <div class="w-10 h-10 rounded-lg bg-blue-500 flex items-center justify-center shadow-sm">
                                    <i class="fas fa-phone text-white"></i>
                                </div>
                                <span class="text-gray-700 font-medium">{{ proposition.telephone }}</span>
                            </div>
                            <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                                <div class="w-10 h-10 rounded-lg bg-blue-500 flex items-center justify-center shadow-sm">
                                    <i class="fas fa-envelope text-white"></i>
                                </div>
                                <span class="text-gray-700 font-medium break-all">{{ proposition.email }}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Carte Localisation -->
                    <div>
                        <div class="flex items-center gap-3 mb-4 pb-2 border-b border-gray-200">
                            <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center">
                                <i class="fas fa-map-marker-alt text-orange-600 text-lg"></i>
                            </div>
                            <h2 class="text-xl font-bold text-gray-800">Localisation</h2>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-5 space-y-2">
                            <div class="flex items-start gap-3">
                                <i class="fas fa-flag text-orange-500 mt-1 w-5"></i>
                                <span class="text-gray-700"><span class="font-medium">Pays :</span> {{ proposition.pays }}</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <i class="fas fa-city text-blue-500 mt-1 w-5"></i>
                                <span class="text-gray-700"><span class="font-medium">Ville :</span> {{ proposition.ville }}</span>
                            </div>
                            <div class="flex items-start gap-3">
                                <i class="fas fa-home text-orange-500 mt-1 w-5"></i>
                                <span class="text-gray-700"><span class="font-medium">Quartier :</span> {{ proposition.quartier }}</span>
                            </div>
                            <div class="flex items-start gap-3 pt-2 border-t border-gray-200">
                                <i class="fas fa-location-dot text-blue-500 mt-1 w-5"></i>
                                <span class="text-gray-700"><span class="font-medium">Adresse :</span> {{ proposition.adresse }}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Document -->
                    {% if proposition.document %}
                    <div>
                        <div class="flex items-center gap-3 mb-4 pb-2 border-b border-gray-200">
                            <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center">
                                <i class="fas fa-file-pdf text-orange-600 text-lg"></i>
                            </div>
                            <h2 class="text-xl font-bold text-gray-800">Document joint</h2>
                        </div>
                        <a href="{{ asset('uploads/documents/' ~ proposition.document) }}" target="_blank" class="flex items-center justify-between gap-3 bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 p-4 rounded-xl text-white font-semibold transition shadow-md">
                            <span class="flex items-center gap-3">
                                <i class="fas fa-file-pdf text-xl"></i>
                                Voir le document
                            </span>
                            <i class="fas fa-external-link-alt"></i>
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Actions -->
            <div class="mt-10 pt-6 border-t border-gray-200 flex flex-wrap gap-4 justify-end">
                <form method="post" action="{{ path('admin_propositions_refuser', {'id': proposition.id}) }}" class="inline" onsubmit="return confirm('Refuser définitivement cette proposition ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('refuser_proposition_' ~ proposition.id) }}">
                    <button class="flex items-center gap-2 px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold rounded-xl transition">
                        <i class="fas fa-times"></i>
                        Refuser
                    </button>
                </form>
                <form method="post" action="{{ path('admin_propositions_valider', {'id': proposition.id}) }}" class="inline" onsubmit="return confirm('Valider et créer l\'orphelinat ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('valider_proposition_' ~ proposition.id) }}">
                    <button class="flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold rounded-xl shadow-md transition">
                        <i class="fas fa-check-circle"></i>
                        Valider & Créer l'orphelinat
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}