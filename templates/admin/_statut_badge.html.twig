{# Badge pour PropositionStatut, SignalementStatut ou OrphelinatStatut : couleur + icône + libellé #}
{% set styles = {
    en_attente: ['om-badge-warning', 'hourglass'],
    nouveau: ['om-badge-warning', 'bell'],
    en_verification: ['om-badge-info', 'search'],
    en_cours: ['om-badge-info', 'loader-circle'],
    acceptee: ['om-badge-trust', 'check'],
    traite: ['om-badge-trust', 'check'],
    actif: ['om-badge-trust', 'circle'],
    refusee: ['om-badge-danger', 'x'],
    rejete: ['om-badge-neutral', 'ban'],
    ferme: ['om-badge-danger', 'door-closed'],
    archive: ['om-badge-neutral', 'archive'],
} %}
{% set style = styles[statut.value] ?? ['om-badge-neutral', 'circle'] %}
<span class="{{ style[0] }}">{{ ux_icon('lucide:' ~ (style[1]), {class: 'text-[10px]'}) }}{{ statut.label }}</span>
