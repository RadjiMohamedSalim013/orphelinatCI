{% extends 'admin/layout.html.twig' %}

{% block title %}Dashboard - OrphaMap Admin{% endblock %}

{% block content %}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="space-y-10">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">

        <div>
            <h1 class="text-3xl md:text-4xl font-extrabold text-gray-800 flex items-center gap-3">
                <i class="fa-solid fa-gauge-high text-orange-500"></i>
                Dashboard Admin
            </h1>

            <p class="text-gray-500 mt-2">
                Vue globale de la plateforme OrphaMap
            </p>
        </div>

        <div class="flex gap-3">

            <div class="bg-white border rounded-xl px-4 py-2 text-sm text-gray-600 shadow-sm">
                <i class="fa-solid fa-clock text-orange-500 mr-2"></i>
                Aujourd’hui
            </div>

        </div>

    </div>

    <!-- QUICK ACTIONS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <a href="{{ path('admin_propositions_index') }}"
           class="group bg-white border rounded-2xl p-6 shadow-sm hover:shadow-xl hover:-translate-y-1 transition">

            <div class="flex items-center justify-between">

                <div class="flex items-center gap-3">

                    <div class="h-12 w-12 rounded-xl bg-orange-50 flex items-center justify-center
                                group-hover:bg-orange-500 transition">

                        <i class="fa-solid fa-inbox text-orange-500 group-hover:text-white"></i>

                    </div>

                    <div>
                        <h3 class="font-semibold text-gray-800">Propositions</h3>
                        <p class="text-sm text-gray-500">À valider</p>
                    </div>

                </div>

                <span class="text-xs bg-orange-50 text-orange-600 px-3 py-1 rounded-full font-semibold">
                    {{ propositions|length }}
                </span>

            </div>

        </a>

        <a href="{{ path('admin_orphelinat_list') }}"
           class="group bg-white border rounded-2xl p-6 shadow-sm hover:shadow-xl hover:-translate-y-1 transition">

            <div class="flex items-center justify-between">

                <div class="flex items-center gap-3">

                    <div class="h-12 w-12 rounded-xl bg-green-50 flex items-center justify-center
                                group-hover:bg-green-500 transition">

                        <i class="fa-solid fa-building text-green-500 group-hover:text-white"></i>

                    </div>

                    <div>
                        <h3 class="font-semibold text-gray-800">Orphelinats</h3>
                        <p class="text-sm text-gray-500">Base de données</p>
                    </div>

                </div>

                <span class="text-xs bg-green-50 text-green-600 px-3 py-1 rounded-full font-semibold">
                    {{ totalOrphelinats }}
                </span>

            </div>

        </a>

        <div class="bg-white border rounded-2xl p-6 shadow-sm">

            <div class="flex items-center justify-between">

                <div class="flex items-center gap-3">

                    <div class="h-12 w-12 rounded-xl bg-blue-50 flex items-center justify-center">
                        <i class="fa-solid fa-users text-blue-500"></i>
                    </div>

                    <div>
                        <h3 class="font-semibold text-gray-800">Utilisateurs</h3>
                        <p class="text-sm text-gray-500">Comptes actifs</p>
                    </div>

                </div>

                <span class="text-xs bg-blue-50 text-blue-600 px-3 py-1 rounded-full font-semibold">
                    {{ totalUsers }}
                </span>

            </div>

        </div>

    </div>

    <!-- STATS GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

        <!-- CARD -->
        <div class="bg-white border rounded-2xl p-6 shadow-sm hover:shadow-lg transition">

            <div class="flex items-center justify-between">
                <i class="fa-solid fa-chart-line text-orange-500 text-xl"></i>
                <span class="text-2xl font-bold">{{ propositions|length }}</span>
            </div>

            <p class="text-gray-500 mt-3 text-sm">Propositions en attente</p>

        </div>

        <div class="bg-white border rounded-2xl p-6 shadow-sm hover:shadow-lg transition">

            <div class="flex items-center justify-between">
                <i class="fa-solid fa-building text-green-500 text-xl"></i>
                <span class="text-2xl font-bold">{{ totalOrphelinats }}</span>
            </div>

            <p class="text-gray-500 mt-3 text-sm">Orphelinats enregistrés</p>

        </div>

        <div class="bg-white border rounded-2xl p-6 shadow-sm hover:shadow-lg transition">

            <div class="flex items-center justify-between">
                <i class="fa-solid fa-user text-blue-500 text-xl"></i>
                <span class="text-2xl font-bold">{{ totalUsers }}</span>
            </div>

            <p class="text-gray-500 mt-3 text-sm">Utilisateurs actifs</p>

        </div>

        <div class="bg-white border rounded-2xl p-6 shadow-sm hover:shadow-lg transition">

            <div class="flex items-center justify-between">
                <i class="fa-solid fa-layer-group text-orange-500 text-xl"></i>
                <span class="text-2xl font-bold">{{ totalPropositions }}</span>
            </div>

            <p class="text-gray-500 mt-3 text-sm">Total propositions</p>

        </div>

    </div>

</div>

{% endblock %}