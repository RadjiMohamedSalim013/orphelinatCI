{% extends 'base.html.twig' %}

{% block title %}Connexion — Administration OrphaMap CI{% endblock %}
{% block meta_robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block page %}
    <main id="contenu" class="flex min-h-screen flex-col items-center justify-center bg-page px-4 py-12">
        <a href="{{ path('home') }}" class="rounded-md" aria-label="OrphaMap CI, accueil">{% include 'partials/_logo.html.twig' %}</a>

        <div class="om-card mt-8 w-full max-w-sm p-6 shadow-raised sm:p-8">
            <h1 class="om-h3 !text-xl">Espace d’administration</h1>
            <p class="mt-1 text-sm text-ink-500">Réservé à l’équipe OrphaMap CI.</p>

            <form method="post" class="mt-6 space-y-5" data-controller="ui" data-action="submit->ui#loading">
                {% if error %}
                    <div class="om-alert-error" role="alert">
                        <i class="fa-solid fa-circle-exclamation mt-0.5" aria-hidden="true"></i>
                        <p>{{ error.messageKey == 'Invalid credentials.' ? 'E-mail ou mot de passe incorrect.' : error.messageKey|trans(error.messageData, 'security') }}</p>
                    </div>
                {% endif %}

                <div>
                    <label for="email" class="om-label">E-mail</label>
                    <input type="email" id="email" name="email" value="{{ last_username }}" required autofocus autocomplete="username" class="om-input">
                </div>
                <div>
                    <label for="password" class="om-label">Mot de passe</label>
                    <input type="password" id="password" name="password" required autocomplete="current-password" class="om-input">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="om-btn-primary w-full" data-ui-target="submit" data-loading-label="Connexion…">
                    Se connecter
                </button>
            </form>
        </div>

        <a href="{{ path('home') }}" class="om-btn-ghost om-btn-sm mt-6"><i class="fa-solid fa-arrow-left text-xs" aria-hidden="true"></i> Retour au site public</a>
    </main>
{% endblock %}
