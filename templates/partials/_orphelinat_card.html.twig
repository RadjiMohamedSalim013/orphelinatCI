{#
    Carte d'établissement. Variables : orphelinat, ligne (bool) pour la présentation en liste.
    Le lien couvre toute la carte (after:inset-0) tout en restant un seul élément focalisable.
#}
{% set ligne = ligne|default(false) %}
<article class="om-card-interactive group relative flex overflow-hidden {{ ligne ? 'flex-row' : 'flex-col' }}">
    <div class="{{ ligne ? 'w-28 shrink-0 sm:w-44' : 'aspect-[16/10]' }} relative bg-ink-100">
        {% if orphelinat.image %}
            <img src="{{ image_url(orphelinat.image, 640) }}" alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover">
        {% else %}
            <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-brand-50 to-ink-50 text-brand-300">
                {{ ux_icon('lucide:house', {class: '' ~ ' ' ~ (ligne ? 'text-2xl' : 'text-4xl')}) }}
            </div>
        {% endif %}
    </div>
    <div class="flex min-w-0 flex-1 flex-col gap-2 {{ ligne ? 'p-4' : 'p-5' }}">
        <div>{% include 'partials/_verification_badge.html.twig' %}</div>
        <h3 class="font-display text-base font-bold leading-snug text-ink-900 sm:text-[17px]">
            <a href="{{ path('orphelinat_show', {id: orphelinat.id, slug: orphelinat.slug}) }}" class="rounded-sm after:absolute after:inset-0 focus:outline-none group-hover:text-brand-700">{{ orphelinat.nom }}</a>
        </h3>
        <p class="flex items-start gap-2 text-sm text-ink-600">
            {{ ux_icon('lucide:map-pin', {class: 'mt-1 text-xs text-ink-400'}) }}
            <span class="line-clamp-2">{{ orphelinat.localisationLabel }}</span>
        </p>
        {% if orphelinat.telephone %}
            <p class="flex items-center gap-2 text-sm text-ink-600">
                {{ ux_icon('lucide:phone', {class: 'text-xs text-ink-400'}) }}{{ orphelinat.telephone }}
            </p>
        {% endif %}
        <span class="mt-auto inline-flex items-center gap-1.5 pt-1 text-sm font-semibold text-brand-700" aria-hidden="true">
            Voir la fiche {{ ux_icon('lucide:arrow-right', {class: 'text-xs transition group-hover:translate-x-0.5'}) }}
        </span>
    </div>
</article>
