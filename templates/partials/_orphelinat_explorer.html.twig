<section id="orphelinat-explorer" class="relative max-w-7xl mx-auto px-4 py-10 sm:px-6 lg:px-8 space-y-10 overflow-hidden">

    <!-- BACKGROUND PLUS VIVANT (SANS GRADIENT) -->
    <div class="absolute inset-0 pointer-events-none">

        <!-- texture points -->
        <div class="absolute inset-0 opacity-[0.06]"
             style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 18px 18px;">
        </div>

        <!-- formes décoratives -->
        <div class="absolute -top-32 -left-32 w-[400px] h-[400px] bg-gray-200 rounded-full blur-3xl opacity-40"></div>
        <div class="absolute bottom-0 -right-32 w-[420px] h-[420px] bg-orange-100 rounded-full blur-3xl opacity-50"></div>

        <!-- ligne verticale décorative -->
        <div class="absolute left-1/2 top-0 bottom-0 w-px bg-gray-200 opacity-40"></div>

    </div>

    <div class="relative space-y-8">

        <!-- HEADER -->
        <div class="space-y-2">

            <div class="inline-flex items-center gap-2 text-xs font-semibold text-orange-600 bg-orange-50 px-3 py-1 rounded-full w-fit border border-orange-100">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 8c-3.866 0-7 2.239-7 5s3.134 5 7 5 7-2.239 7-5-3.134-5-7-5z"/>
                </svg>
                Explorer
            </div>

            <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight">
                Trouver un orphelinat
            </h1>

            <p class="text-gray-500 max-w-xl">
                Recherchez rapidement et filtrez les structures disponibles.
            </p>

        </div>

        <!-- FILTER BAR -->
<form method="GET"
              id="orphelinat-filters"

              class="relative bg-white/95 border border-gray-200 rounded-2xl p-4 shadow-sm
             flex flex-col lg:flex-row gap-3 lg:items-center backdrop-blur"
            >
            <input type="hidden" name="_scroll_to" value="orphelinat-explorer">

            <!-- SEARCH -->
            <div class="flex-1 relative group">

                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-orange-500 transition">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M21 21l-4.35-4.35m1.9-5.65a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </span>

                <input type="text"
                       name="search"
                       value="{{ currentFilters.search }}"
                       placeholder="Rechercher un orphelinat..."
                       class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 text-sm
                              focus:outline-none focus:ring-2 focus:ring-orange-100 focus:border-orange-400
                              transition bg-white">

            </div>

            <!-- SELECTS -->
            <select name="pays_id"
                    class="px-3 py-3 rounded-xl border border-gray-200 text-sm
                           focus:outline-none focus:ring-2 focus:ring-orange-100 focus:border-orange-400
                           bg-white transition">
                <option value="">Pays</option>
                {% for pays in filtersData.pays %}
                    <option value="{{ pays.id }}">{{ pays.nom }}</option>
                {% endfor %}
            </select>

            <select name="ville_id"
                    class="px-3 py-3 rounded-xl border border-gray-200 text-sm
                           focus:outline-none focus:ring-2 focus:ring-orange-100 focus:border-orange-400
                           bg-white transition">
                <option value="">Ville</option>
                {% for ville in filtersData.villes %}
                    <option value="{{ ville.id }}">{{ ville.nom }}</option>
                {% endfor %}
            </select>

            <select name="commune_id"
                    class="px-3 py-3 rounded-xl border border-gray-200 text-sm
                           focus:outline-none focus:ring-2 focus:ring-orange-100 focus:border-orange-400
                           bg-white transition">
                <option value="">Commune</option>
                {% for commune in filtersData.communes %}
                    <option value="{{ commune.id }}">{{ commune.nom }}</option>
                {% endfor %}
            </select>


            <!-- ACTIONS -->
            <div class="flex gap-2">

                <button class="px-5 py-3 bg-orange-500 text-white rounded-xl text-sm font-semibold
                               hover:bg-orange-600 active:scale-[0.98] transition shadow-sm">
                    Filtrer
                </button>

                <a href="{{ path('orphelinat_index') }}"
                   class="px-4 py-3 bg-gray-100 text-gray-700 rounded-xl text-sm
                          hover:bg-gray-200 transition">
                    Reset
                </a>

            </div>

        </form>

        <!-- GRID -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

            {% for orphelinat in orphelinats %}

                <a href="{{ path('orphelinat_show', {id: orphelinat.id}) }}"
                   class="group relative block bg-white border border-gray-200 rounded-2xl overflow-hidden
                          transition duration-300 hover:-translate-y-1 hover:shadow-xl">

                    <!-- IMAGE -->
                    <div class="h-44 overflow-hidden bg-gray-100">

                        <img src="/uploads/images/{{ orphelinat.image }}"
                             loading="lazy"
                             alt="Photo de {{ orphelinat.nom }}"
                             class="w-full h-full object-cover group-hover:scale-105 transition duration-500">

                    </div>

                    <!-- CONTENT -->
                    <div class="p-5 space-y-3">

                        <h3 class="font-semibold text-gray-900 group-hover:text-orange-500 transition">
                            {{ orphelinat.nom }}
                        </h3>

                        <div class="space-y-2 text-sm text-gray-500">

                            <div class="flex items-start gap-2">
                                <svg class="h-4 w-4 mt-0.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
                                </svg>
                                <span>{{ orphelinat.adresse }}</span>
                            </div>

                            <div class="flex items-center gap-2">
                                <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                </svg>
                                {{ orphelinat.telephone }}
                            </div>

                        </div>

                        <div class="pt-2">
                            <span class="inline-flex items-center justify-center w-full bg-orange-500 text-white py-2.5 rounded-xl text-sm font-semibold
                                         group-hover:bg-orange-600 transition">
                                Voir détails
                            </span>
                        </div>

                    </div>

                </a>

            {% endfor %}

        </div>

    </div>

</section>