{% for label, messages in app.flashes(['success', 'error', 'warning', 'notice', 'info']) %}
    {% for message in messages %}
        {% set flashVars = label == 'success' ? ['check-circle', 'bg-green-500', 'border-green-400'] : 
            label == 'error' ? ['x-circle', 'bg-red-500', 'border-red-400'] : 
            label == 'warning' ? ['exclamation-triangle', 'bg-yellow-500', 'border-yellow-400'] : 
            label == 'info' ? ['info', 'bg-blue-500', 'border-blue-400'] : 
            ['help-circle', 'bg-gray-500', 'border-gray-400'] %}
        {% set icon = flashVars[0] %}
        {% set bg = flashVars[1] %}
        {% set border = flashVars[2] %}
        <div class="mb-4 flex items-start gap-3 rounded-2xl {{ bg }} {{ border }} p-4 shadow-lg ring-1 ring-white/20 backdrop-blur-sm animate-in slide-in-from-top-2 duration-300" role="alert">
            <svg class="mt-0.5 h-6 w-6 flex-shrink-0 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <div class="flex flex-1 items-center justify-between">
                <div>
                    <p class="font-medium text-white">{{ message }}</p>
                </div>
                <button type="button" class="ml-4 flex h-8 w-8 items-center justify-center rounded-lg text-white hover:bg-white/20 transition-colors" onclick="this.parentElement.parentElement.remove()">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
        </div>
    {% endfor %}
{% endfor %}
