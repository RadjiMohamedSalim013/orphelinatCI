<dialog class="om-dialog" data-confirm-target="dialog" aria-labelledby="confirm-titre" aria-describedby="confirm-message"
        data-action="close->confirm#closed click->confirm#backdrop">
    <div class="p-6">
        <div class="flex items-start gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-50 text-amber-700 ring-1 ring-amber-200" aria-hidden="true">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </span>
            <div>
                <h2 id="confirm-titre" class="om-h3" data-confirm-target="title">Confirmer l’action</h2>
                <p id="confirm-message" class="mt-1 text-sm text-ink-600" data-confirm-target="message"></p>
            </div>
        </div>
    </div>
    <div class="flex flex-col-reverse gap-2 rounded-b-xl border-t border-ink-100 bg-ink-50 px-6 py-4 sm:flex-row sm:justify-end">
        <button type="button" class="om-btn-secondary" data-action="confirm#cancel">Annuler</button>
        <button type="button" class="om-btn-primary" data-confirm-target="accept" data-action="confirm#accept">Confirmer</button>
    </div>
</dialog>
