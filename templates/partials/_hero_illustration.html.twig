    <g class="om-pin" style="--i: 0">
        <ellipse cx="252" cy="226" rx="16" ry="5" fill="#0f172a" opacity=".12"/>
        <path d="M252 132c-19 0-34 15-34 34 0 26 34 58 34 58s34-32 34-58c0-19-15-34-34-34Z" fill="#c2410c"/>
