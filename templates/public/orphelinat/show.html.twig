{% extends 'base.html.twig' %}

{% block title %}{{ orphelinat.nom }} - OrphaMap{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <div class="mb-6">
        <a href="{{ path('orphelinat_index') }}" class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-medium transition">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Retour à la liste
        </a>
    </div>

    <!-- Main Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden border border-gray-200 dark:border-gray-700">
        <!-- Header with image -->
        <div class="relative h-80 w-full overflow-hidden bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-900">
            {% if orphelinat.image %}
                <img src="/uploads/images/{{ orphelinat.image }}" alt="{{ orphelinat.nom }}" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
            {% else %}
                <div class="w-full h-full bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center">
                    <svg class="w-24 h-24 text-white opacity-75" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
                    </svg>
                </div>
            {% endif %}
            <div class="absolute bottom-0 left-0 right-0 p-8">
                <h1 class="text-4xl font-bold text-white drop-shadow-lg">{{ orphelinat.nom }}</h1>
                {% if orphelinat.quartier %}
                    <p class="text-white/90 text-lg mt-2 flex items-center gap-2">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        {{ orphelinat.quartier.nom }}, {{ orphelinat.quartier.commune.nom }}, {{ orphelinat.quartier.commune.ville.nom }}, {{ orphelinat.quartier.commune.ville.pays.nom }}
                    </p>
                {% endif %}
            </div>
        </div>

        <div class="p-8">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Left: Description -->
                <div class="lg:col-span-2 space-y-8">
                    <div>
                        <div class="flex items-center gap-3 mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
                                <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                                </svg>
                            </div>
                            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Description</h2>
                        </div>
                        <div class="prose dark:prose-invert max-w-none text-gray-700 dark:text-gray-300 leading-relaxed">
                            {{ orphelinat.description|nl2br }}
                        </div>
                    </div>
                </div>

                <!-- Right: Contact & Info -->
                <div class="space-y-6">
                    <!-- Contact Card -->
                    <div>
                        <div class="flex items-center gap-3 mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
                            <div class="w-10 h-10 rounded-xl bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center">
                                <svg class="h-5 w-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                </svg>
                            </div>
                            <h2 class="text-xl font-bold text-gray-900 dark:text-white">Contact</h2>
                        </div>
                        <div class="space-y-3">
                            <div class="flex items-center gap-4 p-4 bg-gray-50 dark:bg-gray-700/50 rounded-xl">
                                <div class="w-10 h-10 rounded-lg bg-blue-500 flex items-center justify-center shadow-sm">
                                    <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                    </svg>
                                </div>
                                <span class="text-gray-700 dark:text-gray-300 font-medium">{{ orphelinat.telephone }}</span>
                            </div>
                            <div class="flex items-center gap-4 p-4 bg-gray-50 dark:bg-gray-700/50 rounded-xl">
                                <div class="w-10 h-10 rounded-lg bg-blue-500 flex items-center justify-center shadow-sm">
                                    <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                    </svg>
                                </div>
                                <span class="text-gray-700 dark:text-gray-300 font-medium break-all">{{ orphelinat.email }}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Address Card -->
                    <div>
                        <div class="flex items-center gap-3 mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
                                <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                            </div>
                            <h2 class="text-xl font-bold text-gray-900 dark:text-white">Adresse</h2>
                        </div>
                        <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-5">
                            <p class="text-gray-700 dark:text-gray-300">{{ orphelinat.adresse }}</p>
                            {% if orphelinat.quartier %}
                                <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-600 space-y-1 text-sm text-gray-600 dark:text-gray-400">
                                    <p><strong>Quartier :</strong> {{ orphelinat.quartier.nom }}</p>
                                    <p><strong>Commune :</strong> {{ orphelinat.quartier.commune.nom }}</p>
                                    <p><strong>Ville :</strong> {{ orphelinat.quartier.commune.ville.nom }}</p>
                                    <p><strong>Pays :</strong> {{ orphelinat.quartier.commune.ville.pays.nom }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Document -->
                    {% if orphelinat.document %}
                    <div>
                        <div class="flex items-center gap-3 mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
                            <div class="w-10 h-10 rounded-xl bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center">
                                <svg class="h-5 w-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                            </div>
                            <h2 class="text-xl font-bold text-gray-900 dark:text-white">Document</h2>
                        </div>
                        <a href="/uploads/documents/{{ orphelinat.document }}" target="_blank" class="flex items-center justify-between gap-3 bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 p-4 rounded-xl text-white font-semibold transition shadow-md">
                            <span class="flex items-center gap-3">
                                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
                                </svg>
                                Voir le document
                            </span>
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                            </svg>
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

