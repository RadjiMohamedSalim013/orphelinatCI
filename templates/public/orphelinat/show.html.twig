{% extends 'base.html.twig' %}

{% block title %}{{ orphelinat.nom }} - OrphaMap{% endblock %}

{% block body %}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="max-w-5xl mx-auto px-4 py-10 space-y-6">

    <!-- BACK -->
    <a href="{{ path('orphelinat_index') }}"
       class="inline-flex items-center gap-2 text-sm font-semibold text-gray-600 hover:text-orange-600 transition">
        <i class="fa-solid fa-arrow-left"></i>
        Retour
    </a>

    <!-- ================= DOSSIER CARD ================= -->
    <div class="bg-white border rounded-3xl shadow-sm overflow-hidden">

        <!-- HEADER DOSSIER -->
        <div class="bg-gradient-to-r from-orange-500 to-orange-600 p-6 text-white">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

                <div>
                    <h1 class="text-2xl md:text-3xl font-bold">
                        {{ orphelinat.nom }}
                    </h1>

                    {% if orphelinat.quartier %}
                        <p class="text-white/90 text-sm mt-1 flex items-center gap-2">
                            <i class="fa-solid fa-location-dot"></i>
                            {{ orphelinat.quartier.nom }},
                            {{ orphelinat.quartier.commune.nom }}
                        </p>
                    {% endif %}
                </div>

                <div class="text-sm bg-white/20 px-4 py-2 rounded-xl">
                    Dossier OrphaMap
                </div>

            </div>

        </div>

        <!-- BODY -->
        <div class="p-6 space-y-8">

            <!-- PHOTO + CONTACT -->
            <div class="grid md:grid-cols-3 gap-6">

                <!-- PHOTO -->
                <div class="md:col-span-1">

                    <div class="rounded-2xl overflow-hidden border bg-gray-100 h-56">

                        {% if orphelinat.image %}
                            <img src="/uploads/images/{{ orphelinat.image }}"
                                 class="w-full h-full object-cover">
                        {% else %}
                            <div class="w-full h-full flex items-center justify-center bg-orange-100">
                                <i class="fa-solid fa-building text-orange-500 text-5xl"></i>
                            </div>
                        {% endif %}

                    </div>

                </div>

                <!-- CONTACT -->
                <div class="md:col-span-2 space-y-4">

                    <h2 class="font-bold text-gray-800 flex items-center gap-2">
                        <i class="fa-solid fa-address-card text-orange-500"></i>
                        Informations de contact
                    </h2>

                    <div class="border rounded-2xl p-5 space-y-4 bg-gray-50">

                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Téléphone</span>
                            <span class="font-semibold flex items-center gap-2">
                                <i class="fa-solid fa-phone text-blue-500"></i>
                                {{ orphelinat.telephone }}
                            </span>
                        </div>

                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Email</span>
                            <span class="font-semibold flex items-center gap-2">
                                <i class="fa-solid fa-envelope text-blue-500"></i>
                                {{ orphelinat.email }}
                            </span>
                        </div>

                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Adresse</span>
                            <span class="font-semibold flex items-center gap-2 text-right">
                                <i class="fa-solid fa-location-crosshairs text-orange-500"></i>
                                {{ orphelinat.adresse }}
                            </span>
                        </div>

                    </div>

                </div>

            </div>

            <!-- DESCRIPTION -->
            <div>

                <h2 class="font-bold text-gray-800 flex items-center gap-2 mb-3">
                    <i class="fa-solid fa-circle-info text-orange-500"></i>
                    Description du centre
                </h2>

                <div class="border rounded-2xl p-5 bg-white text-gray-600 leading-relaxed">
                    {{ orphelinat.description }}
                </div>

            </div>

            <!-- LOCALISATION -->
            {% if orphelinat.quartier %}
            <div>

                <h2 class="font-bold text-gray-800 flex items-center gap-2 mb-3">
                    <i class="fa-solid fa-map-location-dot text-green-600"></i>
                    Localisation administrative
                </h2>

                <div class="grid sm:grid-cols-2 gap-4">

                    <div class="border rounded-xl p-4">
                        <p class="text-gray-500 text-sm">Pays</p>
                        <p class="font-semibold">
                            {{ orphelinat.quartier.commune.ville.pays.nom }}
                        </p>
                    </div>

                    <div class="border rounded-xl p-4">
                        <p class="text-gray-500 text-sm">Ville</p>
                        <p class="font-semibold">
                            {{ orphelinat.quartier.commune.ville.nom }}
                        </p>
                    </div>

                    <div class="border rounded-xl p-4">
                        <p class="text-gray-500 text-sm">Commune</p>
                        <p class="font-semibold">
                            {{ orphelinat.quartier.commune.nom }}
                        </p>
                    </div>

                    <div class="border rounded-xl p-4">
                        <p class="text-gray-500 text-sm">Quartier</p>
                        <p class="font-semibold">
                            {{ orphelinat.quartier.nom }}
                        </p>
                    </div>

                </div>

            </div>
            {% endif %}

            <!-- DOCUMENT -->
            {% if orphelinat.document %}
            <div class="pt-4">

                <a href="/uploads/documents/{{ orphelinat.document }}"
                   target="_blank"
                   class="inline-flex items-center gap-3 bg-orange-500 hover:bg-orange-600 text-white px-5 py-3 rounded-xl shadow transition">

                    <i class="fa-solid fa-file-pdf text-lg"></i>
                    Télécharger le document officiel

                </a>

            </div>
            {% endif %}

        </div>

    </div>
</div>

{% endblock %}