{% extends 'base.html.twig' %}

{% block title %}Orphelinats - OrphaMap{% endblock %}

{% block body %}

    {% include '/partials/_hero.html.twig' %}

    <div class="mt-14"></div>

    {% include '/partials/_orphelinat_explorer.html.twig' %}

    <script>
        (function () {
            var shouldScroll = false;

            // Cas 1 : l’URL contient déjà #orphelinat-explorer
            if (window.location.hash === '#orphelinat-explorer') {
                shouldScroll = true;
            }

            // Cas 2 : on a demandé explicitement le scroll après soumission des filtres
            var params = new URLSearchParams(window.location.search);
            if (params.get('_scroll_to') === 'orphelinat-explorer') {
                shouldScroll = true;
            }

            if (!shouldScroll) return;

            window.requestAnimationFrame(function () {
                var el = document.getElementById('orphelinat-explorer');
                if (el) {
                    el.scrollIntoView({ behavior: 'auto', block: 'start' });
                }
            });
        })();
    </script>



    <!-- SECTION IMPACT -->
    <section class="relative py-20 overflow-hidden">

        <!-- BACKGROUND SUBTLE -->
        <div class="absolute inset-0">
            <div class="absolute top-10 left-10 w-72 h-72 bg-orange-100/40 rounded-full blur-3xl"></div>
            <div class="absolute bottom-10 right-10 w-72 h-72 bg-gray-100 rounded-full blur-3xl"></div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- HEADER -->
            <div class="text-center mb-14 space-y-3">

                <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight">
                    Un réseau d’orphelinats plus visible
                </h2>

                <p class="text-gray-500 max-w-2xl mx-auto text-base md:text-lg">
                    OrphaMap connecte les structures d’accueil pour améliorer leur visibilité et faciliter le soutien.
                </p>

            </div>

            <!-- GRID -->
            <div class="grid md:grid-cols-3 gap-6">

                <!-- CARD 1 -->
                <div class="group relative p-7 bg-white border border-gray-200 rounded-2xl
                            transition duration-300 hover:-translate-y-2 hover:shadow-xl cursor-pointer">

                    <div class="flex items-center gap-3 mb-4">

                        <div class="h-11 w-11 flex items-center justify-center rounded-xl
                                    bg-orange-50 text-orange-500
                                    group-hover:bg-orange-500 group-hover:text-white transition">

                            <i class="fa-solid fa-location-dot text-lg"></i>

                        </div>

                        <h3 class="font-semibold text-gray-900 group-hover:text-orange-500 transition">
                            Localisation rapide
                        </h3>

                    </div>

                    <p class="text-sm text-gray-500 leading-relaxed">
                        Trouvez un orphelinat en quelques secondes.
                    </p>

                    <div class="mt-5 h-[2px] w-0 bg-orange-500 group-hover:w-16 transition-all duration-300"></div>

                </div>

                <!-- CARD 2 -->
                <div class="group relative p-7 bg-white border border-gray-200 rounded-2xl
                            transition duration-300 hover:-translate-y-2 hover:shadow-xl cursor-pointer">

                    <div class="flex items-center gap-3 mb-4">

                        <div class="h-11 w-11 flex items-center justify-center rounded-xl
                                    bg-orange-50 text-orange-500
                                    group-hover:bg-orange-500 group-hover:text-white transition">

                            <i class="fa-solid fa-eye text-lg"></i>

                        </div>

                        <h3 class="font-semibold text-gray-900 group-hover:text-orange-500 transition">
                            Visibilité accrue
                        </h3>

                    </div>

                    <p class="text-sm text-gray-500 leading-relaxed">
                        Chaque structure est accessible au public.
                    </p>

                    <div class="mt-5 h-[2px] w-0 bg-orange-500 group-hover:w-16 transition-all duration-300"></div>

                </div>

                <!-- CARD 3 -->
                <div class="group relative p-7 bg-white border border-gray-200 rounded-2xl
                            transition duration-300 hover:-translate-y-2 hover:shadow-xl cursor-pointer">

                    <div class="flex items-center gap-3 mb-4">

                        <div class="h-11 w-11 flex items-center justify-center rounded-xl
                                    bg-orange-50 text-orange-500
                                    group-hover:bg-orange-500 group-hover:text-white transition">

                            <i class="fa-solid fa-hand-holding-heart text-lg"></i>

                        </div>

                        <h3 class="font-semibold text-gray-900 group-hover:text-orange-500 transition">
                            Impact social
                        </h3>

                    </div>

                    <p class="text-sm text-gray-500 leading-relaxed">
                        Faciliter les dons et le soutien.
                    </p>

                    <div class="mt-5 h-[2px] w-0 bg-orange-500 group-hover:w-16 transition-all duration-300"></div>

                </div>

            </div>

        </div>

    </section>

{% endblock %}