{% extends 'base.html.twig' %}

{% block title %}OrphaMap CI — Trouver un orphelinat dans votre commune{% endblock %}

{% block canonical %}{{ url('home') }}{% endblock %}

{% block structured_data %}
    {% set site = {
        '@context': 'https://schema.org',
        '@graph': [
            {
                '@type': 'WebSite',
                '@id': url('home') ~ '#site',
                'url': url('home'),
                'name': 'OrphaMap CI',
                'description': 'Annuaire des orphelinats de Côte d’Ivoire, par ville et par commune.',
                'inLanguage': 'fr',
                'potentialAction': {
                    '@type': 'SearchAction',
                    'target': {'@type': 'EntryPoint', 'urlTemplate': url('orphelinat_index') ~ '?q={search_term_string}'},
                    'query-input': 'required name=search_term_string',
                },
            },
            {
                '@type': 'Organization',
                '@id': url('home') ~ '#organisation',
                'name': 'OrphaMap CI',
                'url': url('home'),
                'logo': absolute_url(asset('images/apple-touch-icon.png')),
            },
        ],
    } %}
    <script type="application/ld+json">{{ site|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}</script>
{% endblock %}

{% block body %}
    {# ───── Recherche (au-dessus de la ligne de flottaison) ───── #}
    <section class="relative overflow-hidden border-b border-ink-200/70 bg-white">
        <div class="pointer-events-none absolute -right-40 -top-40 h-[28rem] w-[28rem] rounded-full bg-brand-50 blur-3xl" aria-hidden="true"></div>
        <div class="om-container relative grid gap-8 py-10 sm:py-14 lg:grid-cols-[1.3fr_1fr] lg:gap-x-12 lg:py-16">
            <div class="self-center">
                <p class="om-eyebrow">Annuaire des orphelinats · Côte d’Ivoire</p>
                <h1 class="om-h1 mt-3">
                    Trouvez les orphelinats<br class="hidden sm:block">
                    <span class="text-brand-600">près de chez vous.</span>
                </h1>
                <p class="om-lead mt-4 max-w-xl">
                    Choisissez votre ville et votre commune&nbsp;: OrphaMap vous indique les établissements d’accueil, leur adresse et comment les joindre.
                </p>
            </div>
            <div class="mx-auto hidden w-full max-w-sm lg:row-span-1 lg:block">
                {% include 'partials/_hero_illustration.html.twig' %}
            </div>

            <div class="lg:col-span-2 lg:-mt-6">
                <div class="om-card relative z-10 p-4 shadow-raised sm:p-6">
                    <h2 class="sr-only">Rechercher un orphelinat</h2>
                    {% include 'partials/_search_form.html.twig' with {pays: pays, villes: [], communes: [], criteres: null} %}
                </div>

                {% if stats.actifs > 0 %}
                    <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
                        <div class="flex items-baseline gap-2">
                            <dt class="sr-only">Établissements répertoriés</dt>
                            <dd class="flex items-baseline gap-2"><span class="font-display text-2xl font-extrabold text-ink-900">{{ stats.actifs }}</span>
                            <span class="text-ink-600" aria-hidden="true">établissement{{ stats.actifs > 1 ? 's' }} répertorié{{ stats.actifs > 1 ? 's' }}</span></dd>
                        </div>
                        <div class="flex items-baseline gap-2">
                            <dt class="sr-only">Établissements vérifiés</dt>
                            <dd class="flex items-baseline gap-2"><span class="font-display text-2xl font-extrabold text-trust-700">{{ stats.verifies }}</span>
                            <span class="text-ink-600" aria-hidden="true">vérifié{{ stats.verifies > 1 ? 's' }} par l’équipe</span></dd>
                        </div>
                        <div class="flex items-baseline gap-2">
                            <dt class="sr-only">Communes couvertes</dt>
                            <dd class="flex items-baseline gap-2"><span class="font-display text-2xl font-extrabold text-ink-900">{{ stats.communes }}</span>
                            <span class="text-ink-600" aria-hidden="true">commune{{ stats.communes > 1 ? 's' }} couverte{{ stats.communes > 1 ? 's' }}</span></dd>
                        </div>
                    </dl>
                {% endif %}
            </div>
        </div>
    </section>

    {# ───── Accès direct par commune (données réelles) ───── #}
    {% if communes is not empty %}
        <section class="om-container pt-12 sm:pt-16" aria-labelledby="titre-communes">
            <h2 id="titre-communes" class="om-h3">Explorer par commune</h2>
            <ul class="mt-4 flex flex-wrap gap-2">
                {% for c in communes %}
                    <li>
                        <a href="{{ path('orphelinat_index', {pays: c.paysId, ville: c.villeId, commune: c.communeId}) }}"
                           class="inline-flex min-h-[44px] items-center gap-2 rounded-full border border-ink-200 bg-white px-4 text-sm font-medium text-ink-800 shadow-card transition hover:border-brand-300 hover:bg-brand-50 hover:text-brand-800">
                            {{ c.commune }} <span class="text-ink-400">· {{ c.ville }}</span>
                            <span class="rounded-full bg-ink-100 px-2 text-xs font-semibold text-ink-700">{{ c.total }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {# ───── Derniers ajouts ───── #}
    <section class="om-container om-section !pt-12" aria-labelledby="titre-recents">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
            <div>
                <p class="om-eyebrow">Annuaire</p>
                <h2 id="titre-recents" class="om-h2 mt-1">Ajoutés récemment</h2>
            </div>
            <a href="{{ path('orphelinat_index') }}" class="om-btn-secondary om-btn-sm">Tout l’annuaire <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i></a>
        </div>

        {% if recents is not empty %}
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 max-sm:[&>*:nth-child(n+4)]:hidden">
                {% for orphelinat in recents %}
                    {% include 'partials/_orphelinat_card.html.twig' %}
                {% endfor %}
            </div>
        {% else %}
            {% embed 'partials/_empty.html.twig' with {icone: 'fa-seedling', titre: 'L’annuaire est en cours de constitution', texte: 'Vous connaissez un établissement ? Proposez-le : il sera publié après vérification.'} %}
                {% block actions %}<a href="{{ path('proposer_orphelinat') }}" class="om-btn-primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Proposer un orphelinat</a>{% endblock %}
            {% endembed %}
        {% endif %}
    </section>

    {# ───── Fonctionnement et vérification ───── #}
    <section id="fonctionnement" class="border-y border-ink-200/70 bg-white" aria-labelledby="titre-fonctionnement">
        <div class="om-container om-section grid gap-12 lg:grid-cols-[1fr_1.1fr]">
            <div>
                <p class="om-eyebrow">Comment ça marche</p>
                <h2 id="titre-fonctionnement" class="om-h2 mt-1">Un annuaire construit avec vous, vérifié par l’équipe</h2>
                <p class="om-lead mt-4">Chacun peut proposer un établissement ou signaler une information erronée. Rien n’est publié ni modifié sans contrôle.</p>

                {% if verifies is not empty %}
                    <div class="mt-8">
                        <h3 class="text-sm font-semibold text-ink-900">Dernières fiches vérifiées</h3>
                        <ul class="mt-3 divide-y divide-ink-100 rounded-lg border border-ink-200">
                            {% for o in verifies %}
                                <li>
                                    <a href="{{ path('orphelinat_show', {id: o.id, slug: o.slug}) }}" class="flex min-h-[56px] items-center justify-between gap-3 px-4 py-2 transition hover:bg-ink-50">
                                        <span class="min-w-0">
                                            <span class="block truncate font-semibold text-ink-900">{{ o.nom }}</span>
                                            <span class="block truncate text-xs text-ink-500">{{ o.localisationLabel }}</span>
                                        </span>
                                        <span class="om-badge-trust"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Vérifié</span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>

            <ol class="grid gap-4">
                {% for etape in [
                    {icone: 'fa-map-location-dot', titre: 'Cherchez par lieu', texte: 'Pays, ville puis commune : seuls les établissements correspondants s’affichent, avec leur position sur la carte quand elle est connue.'},
                    {icone: 'fa-address-card', titre: 'Consultez la fiche', texte: 'Adresse, téléphone, présentation et statut de vérification. Les fiches non vérifiées sont clairement signalées.'},
                    {icone: 'fa-hand-holding-heart', titre: 'Contribuez', texte: 'Proposez un établissement manquant ou signalez une erreur. L’équipe contrôle chaque information avant publication.'},
                ] %}
                    <li class="flex gap-4 rounded-lg border border-ink-200 bg-page p-5">
                        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-white text-brand-600 shadow-card ring-1 ring-ink-200" aria-hidden="true">
                            <i class="fa-solid {{ etape.icone }}"></i>
                        </span>
                        <div>
                            <h3 class="font-display font-bold text-ink-900"><span class="sr-only">Étape {{ loop.index }} : </span>{{ etape.titre }}</h3>
                            <p class="mt-1 text-sm text-ink-600">{{ etape.texte }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </section>

    {# ───── Appel à contribution ───── #}
    <section class="om-container om-section" aria-labelledby="titre-contribuer">
        <div class="relative overflow-hidden rounded-xl bg-ink-900 px-6 py-10 text-white sm:px-10 sm:py-12">
            <div class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-brand-600/30 blur-3xl" aria-hidden="true"></div>
            <div class="relative grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
                <div>
                    <h2 id="titre-contribuer" class="font-display text-2xl font-bold text-white sm:text-3xl">Un établissement manque à l’annuaire&nbsp;?</h2>
                    <p class="mt-2 max-w-xl text-ink-300">Quelques minutes suffisent pour le proposer. Vous pourrez suivre l’avancement de la vérification.</p>
                </div>
                <a href="{{ path('proposer_orphelinat') }}" class="om-btn-primary om-btn-lg"><i class="fa-solid fa-plus" aria-hidden="true"></i> Proposer un orphelinat</a>
            </div>
        </div>
    </section>
{% endblock %}
