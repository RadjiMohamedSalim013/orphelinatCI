{% extends 'base.html.twig' %}

{% block title %}Suivi de votre proposition — OrphaMap CI{% endblock %}
{% block meta_robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block body %}
    {% set statut = proposition.statut.value %}
    {% set rang = {en_attente: 0, en_verification: 1, acceptee: 2, refusee: 2}[statut] %}
    {% set etapes = [
        {label: 'Reçue', icone: 'inbox'},
        {label: 'En vérification', icone: 'search'},
        {label: statut == 'refusee' ? 'Refusée' : (statut == 'acceptee' ? 'Publiée' : 'Décision'), icone: statut == 'refusee' ? 'x' : 'circle-check'},
    ] %}

    <div class="om-container max-w-2xl py-10 sm:py-14">
        {% if statut in ['en_attente', 'acceptee'] %}
            <div class="mb-8 flex items-center gap-4" data-reveal="zoom">
                <svg class="h-16 w-16 shrink-0" viewBox="0 0 64 64" aria-hidden="true">
                    <circle cx="32" cy="32" r="30" fill="rgb(var(--trust-50))" stroke="rgb(var(--trust-200))" stroke-width="2"/>
                    <circle class="om-onde" cx="32" cy="32" r="30" fill="rgb(var(--trust-500))" opacity=".25"/>
                    <path class="om-succes-coche" d="M20 33l8 8 16-17" fill="none" stroke="rgb(var(--trust-600))" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div>
                    <p class="font-display text-xl font-bold text-ink-900">{{ statut == 'acceptee' ? 'Établissement publié !' : 'Merci, c’est bien reçu !' }}</p>
                    <p class="text-sm text-ink-600">{{ statut == 'acceptee' ? 'Votre contribution enrichit l’annuaire.' : 'Votre proposition rejoint la file de vérification.' }}</p>
                </div>
            </div>
        {% endif %}
        <p class="om-eyebrow">Suivi de votre proposition</p>
        <h1 class="om-h2 mt-1">{{ proposition.nom }}</h1>
        <p class="mt-1 text-sm text-ink-500">
            Référence <strong class="font-mono text-ink-800">{{ proposition.reference }}</strong> · envoyée le {{ proposition.createdAt|date('d/m/Y à H:i') }}
        </p>

        <div class="om-card mt-6 overflow-hidden">
            <ol class="grid grid-cols-3 border-b border-ink-100" aria-label="Avancement">
                {% for etape in etapes %}
                    {% set fait = loop.index0 <= rang %}
                    {% set refus = loop.last and statut == 'refusee' %}
                    <li class="relative flex flex-col items-center gap-2 px-2 py-5 text-center text-xs font-semibold sm:text-sm {{ fait ? (refus ? 'text-red-800' : 'text-trust-800') : 'text-ink-400' }}"
                        {% if loop.index0 == rang %}aria-current="step"{% endif %}>
                        <span class="flex h-9 w-9 items-center justify-center rounded-full ring-1 {{ fait ? (refus ? 'bg-red-50 ring-red-200' : 'bg-trust-50 ring-trust-200') : 'bg-ink-50 ring-ink-200' }}" aria-hidden="true">
                            {{ ux_icon('lucide:' ~ (etape.icone)) }}
                        </span>
                        {{ etape.label }}<span class="sr-only">{{ fait ? ' (étape atteinte)' : ' (à venir)' }}</span>
                        {% if not loop.last %}<span class="absolute left-[calc(50%+1.5rem)] right-[calc(-50%+1.5rem)] top-[2.35rem] h-px {{ loop.index0 < rang ? 'bg-trust-300' : 'bg-ink-200' }}" aria-hidden="true"></span>{% endif %}
                    </li>
                {% endfor %}
            </ol>

            <div class="om-card-pad text-sm text-ink-700">
                {% if statut == 'en_attente' %}
                    <p>Votre proposition a bien été reçue et attend d’être examinée. Elle n’apparaît pas dans l’annuaire tant qu’elle n’a pas été vérifiée.</p>
                {% elseif statut == 'en_verification' %}
                    <p>L’équipe vérifie actuellement les informations. Elle peut vous contacter si des précisions sont nécessaires.</p>
                {% elseif statut == 'acceptee' %}
                    <p class="font-semibold text-ink-900">Merci pour votre contribution&nbsp;!</p>
                    <p class="mt-1">L’établissement fait désormais partie de l’annuaire.</p>
                    {% if proposition.orphelinat and proposition.orphelinat.publiclyVisible %}
                        <a class="om-btn-primary mt-4" href="{{ path('orphelinat_show', {id: proposition.orphelinat.id, slug: proposition.orphelinat.slug}) }}">Voir la fiche publiée {{ ux_icon('lucide:arrow-right', {class: 'text-xs'}) }}</a>
                    {% endif %}
                {% else %}
                    <p>Votre proposition n’a pas été retenue.</p>
                    {% if proposition.motifRefus %}
                        <p class="mt-3 rounded-md bg-ink-50 p-3"><strong>Motif&nbsp;:</strong> {{ proposition.motifRefus }}</p>
                    {% endif %}
                {% endif %}
            </div>
        </div>

        <div class="om-alert-info mt-6">
            {{ ux_icon('lucide:bookmark', {class: 'mt-0.5'}) }}
            <p>Ajoutez cette page à vos favoris pour suivre votre demande. Son adresse est personnelle&nbsp;: ne la partagez pas.</p>
        </div>

        <div class="mt-8 flex flex-wrap gap-2">
            <a href="{{ path('orphelinat_index') }}" class="om-btn-secondary">{{ ux_icon('lucide:search') }} Rechercher un orphelinat</a>
            <a href="{{ path('proposer_orphelinat') }}" class="om-btn-ghost">Proposer un autre établissement</a>
        </div>
    </div>
{% endblock %}
