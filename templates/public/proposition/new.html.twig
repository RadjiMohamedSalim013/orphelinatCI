{% extends 'base.html.twig' %}

{% form_theme form 'form/tailwind_layout.html.twig' %}

{% block title %}Proposer un orphelinat - OrphaMap{% endblock %}

{% block body %}

<style>
    .form-control {
        width: 100%;
        border: 1.5px solid #e5e7eb;
        background: #f9fafb;
        padding: 12px 14px;
        border-radius: 14px;
        transition: all .2s ease;
        outline: none;
        font-size: 14px;
    }

    .form-control:focus {
        border-color: #f97316;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(249,115,22,0.15);
    }

    .form-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        color: #111827;
        padding-bottom: 10px;
        border-bottom: 1px solid #e5e7eb;
    }

    .section-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 22px;
    }
</style>

<div class="max-w-5xl mx-auto px-4 py-12 space-y-10">

    <!-- HEADER -->
    <div class="text-center space-y-3">

        <div class="h-14 w-14 bg-orange-500 rounded-2xl flex items-center justify-center mx-auto shadow-md">
            <i class="fa-solid fa-plus text-white"></i>
        </div>

        <h1 class="text-3xl md:text-4xl font-bold text-gray-900">
            Proposer un <span class="text-orange-500">orphelinat</span>
        </h1>

        <p class="text-gray-500 max-w-xl mx-auto">
            Les informations seront vérifiées avant publication.
        </p>
    </div>

    {{ include('partials/_flashes.html.twig') }}

    <!-- FORM -->
    <div class="section-card shadow-sm">

        {{ form_start(form, { attr: { novalidate: 'novalidate', class: 'space-y-8' } }) }}

        <!-- SECTION 1 -->
        <div>
            <div class="form-title">
                <i class="fa-solid fa-building text-orange-500"></i>
                Informations générales
            </div>

            <div class="grid md:grid-cols-2 gap-5 mt-5">

                {{ form_row(form.nom, { attr: { class: 'form-control' } }) }}
                {{ form_row(form.pays, { attr: { class: 'form-control' } }) }}
                {{ form_row(form.ville, { attr: { class: 'form-control' } }) }}
                {{ form_row(form.quartier, { attr: { class: 'form-control' } }) }}

            </div>

            <div class="mt-5">
                {{ form_row(form.adresse, { attr: { class: 'form-control' } }) }}
            </div>
        </div>

        <!-- SECTION 2 -->
        <div>
            <div class="form-title">
                <i class="fa-solid fa-phone text-orange-500"></i>
                Contact
            </div>

            <div class="grid md:grid-cols-2 gap-5 mt-5">

                {{ form_row(form.telephone, { attr: { class: 'form-control' } }) }}
                {{ form_row(form.email, { attr: { class: 'form-control' } }) }}

            </div>

            <div class="mt-5">
                {{ form_row(form.description, { attr: { class: 'form-control', rows: 5 } }) }}
            </div>
        </div>

        <!-- SECTION 3 -->
        <div>
            <div class="form-title">
                <i class="fa-solid fa-paperclip text-orange-500"></i>
                Fichiers
            </div>

            <div class="grid md:grid-cols-2 gap-5 mt-5">

                {{ form_row(form.image, { attr: { class: 'form-control bg-white' } }) }}
                {{ form_row(form.document, { attr: { class: 'form-control bg-white' } }) }}

            </div>
        </div>

        <!-- SECTION 4 -->
        <div>
            <div class="form-title">
                <i class="fa-solid fa-user text-orange-500"></i>
                Proposant
            </div>

            <div class="grid md:grid-cols-2 gap-5 mt-5">

                {{ form_row(form.nomProposant, { attr: { class: 'form-control' } }) }}
                {{ form_row(form.contactProposant, { attr: { class: 'form-control' } }) }}

            </div>
        </div>

        <!-- ACTIONS -->
        <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t">

            <a href="{{ path('orphelinat_index') }}"
               class="flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-4 rounded-xl transition">
                Annuler
            </a>

            <button type="submit"
                    class="flex-1 bg-orange-500 hover:bg-orange-600 text-white font-bold py-4 rounded-xl shadow-md transition">
                <i class="fa-solid fa-paper-plane mr-2"></i>
                Envoyer
            </button>

        </div>

        {{ form_end(form) }}

    </div>
</div>

{% endblock %}