{% use 'form_div_layout.html.twig' %}

{# Thème de formulaire OrphaMap : composants om-* de assets/styles/app.css #}

{%- block form_row -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: attr|merge({'aria-describedby': id ~ '_help'})} -%}
    {%- endif -%}
    <div{% with {attr: row_attr|merge({class: (row_attr.class|default('') ~ ' mb-5')|trim})} %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock form_row -%}

{%- block form_label -%}
    {%- if label is not same as(false) -%}
        {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' om-label')|trim}) -%}
        {%- if not compound -%}{%- set label_attr = label_attr|merge({for: id}) -%}{%- endif -%}
        {%- if label is empty -%}{%- set label = name|humanize -%}{%- endif -%}
        {%- set balise = compound ? 'p' : 'label' -%}
        <{{ balise }}{% if compound %} id="{{ id }}_label"{% endif %}{% with {attr: label_attr} %}{{ block('attributes') }}{% endwith %}>
            {{- translation_domain is same as(false) ? label : label|trans(label_translation_parameters, translation_domain) -}}
            {%- if required or (mention_obligatoire ?? false) %} <span class="text-red-700" aria-hidden="true">*</span>{% else %} <span class="font-normal text-ink-400">(facultatif)</span>{% endif -%}
        </{{ balise }}>
    {%- endif -%}
{%- endblock form_label -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <div id="{{ id }}_errors">
            {%- for error in errors -%}
                <p class="om-error">{{ ux_icon('lucide:circle-alert', {class: 'mt-0.5'}) }}<span>{{ error.message }}</span></p>
            {%- endfor -%}
        </div>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        <p class="om-help" id="{{ id }}_help">{{ help }}</p>
    {%- endif -%}
{%- endblock form_help -%}

{%- block widget_attributes -%}
    {%- if errors|length > 0 -%}
        {%- set attr = attr|merge({'aria-invalid': 'true', 'aria-errormessage': id ~ '_errors'}) -%}
    {%- endif -%}
    {%- if required -%}
        {%- set attr = attr|merge({'aria-required': 'true'}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{%- block form_widget_simple -%}
    {%- if type is not defined or type not in ['hidden', 'file'] -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' om-input' ~ (errors|length > 0 ? ' om-input-error' : ''))|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{%- block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' om-input' ~ (errors|length > 0 ? ' om-input-error' : ''))|trim}) -%}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' om-input' ~ (errors|length > 0 ? ' om-input-error' : ''))|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed -%}

{%- block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }} role="radiogroup" aria-labelledby="{{ id }}_label" class="grid gap-2 sm:grid-cols-2">
        {%- for child in form %}
            <label class="flex min-h-[48px] cursor-pointer items-center gap-3 rounded-md border border-ink-300 bg-white px-3.5 py-2.5 text-sm text-ink-800 transition hover:border-ink-400 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50 has-[:checked]:text-brand-900 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand-300">
                {{- form_widget(child, {attr: {class: 'h-4 w-4 shrink-0 accent-brand-600'}}) -}}
                <span>{{ child.vars.label }}</span>
            </label>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block checkbox_row -%}
    <div{% with {attr: row_attr|merge({class: (row_attr.class|default('') ~ ' mb-5')|trim})} %}{{ block('attributes') }}{% endwith %}>
        <label class="flex cursor-pointer items-start gap-3 text-sm text-ink-800" for="{{ id }}">
            {{- form_widget(form, {attr: attr|merge({class: (attr.class|default('') ~ ' om-checkbox')|trim})}) -}}
            <span>{{ label }}{% if required %} <span class="text-red-700" aria-hidden="true">*</span>{% endif %}</span>
        </label>
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block file_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' block w-full cursor-pointer rounded-md border border-dashed border-ink-300 bg-ink-50/60 p-2 text-sm text-ink-600 transition hover:border-brand-400 file:mr-3 file:min-h-[36px] file:cursor-pointer file:rounded-md file:border-0 file:bg-white file:px-4 file:text-sm file:font-semibold file:text-brand-700 file:shadow-sm file:ring-1 file:ring-ink-200 hover:file:bg-brand-50')|trim}) -%}
    {%- set type = 'file' -%}
    <input type="file" {{ block('widget_attributes') }}{% if multiple|default(false) %} multiple="multiple"{% endif %} />
{%- endblock file_widget -%}
