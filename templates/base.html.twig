<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set seo_titre %}{% block title %}OrphaMap CI — Annuaire des orphelinats{% endblock %}{% endset %}
    {% set seo_description %}{% block meta_description %}Trouvez les orphelinats de votre ville et de votre commune en Côte d’Ivoire : adresses, contacts et fiches vérifiées par l’équipe OrphaMap CI.{% endblock %}{% endset %}
    {% set seo_canonical %}{% block canonical %}{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}{% endblock %}{% endset %}
    {% set seo_image %}{% block og_image %}{{ absolute_url(asset('images/og-orphamap.png')) }}{% endblock %}{% endset %}

    <title>{{ seo_titre|trim }}</title>
    <meta name="description" content="{{ seo_description|trim }}">
    {% block meta_robots %}{% endblock %}
    <link rel="canonical" href="{{ seo_canonical|trim }}">

    <meta property="og:site_name" content="OrphaMap CI">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:title" content="{{ seo_titre|trim }}">
    <meta property="og:description" content="{{ seo_description|trim }}">
    <meta property="og:url" content="{{ seo_canonical|trim }}">
    <meta property="og:image" content="{{ seo_image|trim }}">
    <meta property="og:image:alt" content="OrphaMap CI, l’annuaire des orphelinats de Côte d’Ivoire">
    <meta name="twitter:card" content="summary_large_image">

    <meta name="theme-color" content="#c2410c">
    <script nonce="{{ csp_nonce() }}">document.documentElement.classList.add('js');setTimeout(function(){if(!document.documentElement.dataset.reveal){document.documentElement.classList.remove('js')}},2500)</script>
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
    <link rel="manifest" href="{{ asset('site.webmanifest') }}">

    {% block structured_data %}{% endblock %}

    {# Polices auto-hébergées : préchargement des sous-ensembles latins (premier affichage sans saut) #}
    <link rel="preload" href="{{ asset('fonts/inter-latin-wght-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('fonts/plus-jakarta-sans-latin-wght-normal.woff2') }}" as="font" type="font/woff2" crossorigin>

    {# Feuille de style en <link> (et non importée en JS) : compatible avec la CSP stricte #}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app', {nonce: csp_nonce()}) }}{% endblock %}
    {% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}" data-controller="confirm reveal" data-action="submit->confirm#intercept:capture">
<a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] om-btn-primary">Aller au contenu</a>

{% block page %}
    <div class="flex min-h-screen flex-col">
        {% include 'partials/_header.html.twig' %}
        <main id="contenu" class="flex-1">
            {% block body %}{% endblock %}
        </main>
        {% include 'partials/_footer.html.twig' %}
    </div>
{% endblock %}

{% include 'partials/_flashes.html.twig' %}
{% include 'partials/_confirm_dialog.html.twig' %}
</body>
</html>
